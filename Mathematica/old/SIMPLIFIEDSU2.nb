Cell["\<\
An arbitrary element of su2, where \[Theta] and \[Phi] define a unit vector, \
and \[Zeta]/2 a rotation around that unit vector.\
\>", "Text",
 CellChangeTimes->{{3.95564668890934*^9, 3.955646734628847*^9}, {
  3.957530340840086*^9, 
  3.957530340918545*^9}},ExpressionUUID->"da8e31af-d3dc-f041-8aee-\
288fefd00416"],

Cell[BoxData[
 RowBox[{
  RowBox[{"su2", "[", 
   RowBox[{"\[Theta]_", ",", "\[Phi]_", ",", "\[Zeta]_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", "\[Zeta]", "]"}], "-", 
       RowBox[{"I", "*", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
        RowBox[{"Sin", "[", "\[Zeta]", "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", "\[Zeta]", "]"}], "*", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "I"}], ")"}], "*", 
          RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "-", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ")"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", "\[Zeta]", "]"}], "*", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "I"}], ")"}], "*", 
          RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "+", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ")"}]}], ",", 
      RowBox[{
       RowBox[{"Cos", "[", "\[Zeta]", "]"}], "+", 
       RowBox[{"I", "*", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
        RowBox[{"Sin", "[", "\[Zeta]", "]"}]}]}]}], "}"}]}], "}"}]}]], "Input",
 CellChangeTimes->{{3.957530152913765*^9, 3.957530153682675*^9}, {
  3.95753027681342*^9, 3.957530288108265*^9}, {3.9575303449465036`*^9, 
  3.95753034522868*^9}},
 CellLabel->"In[6]:=",ExpressionUUID->"57ed7990-652b-0449-8ae9-0eddd5f22fc8"],


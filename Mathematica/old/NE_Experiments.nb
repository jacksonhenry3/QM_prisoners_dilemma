              RowBox[{"Range", "[", "n", "]"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"#", "==", "j0"}], ",", "True", ",", 
                  RowBox[{
                   RowBox[{"B", "[", 
                    RowBox[{"[", 
                    RowBox[{"i0", ",", "#"}], "]"}], "]"}], "<=", 
                   RowBox[{"B", "[", 
                    RowBox[{"[", 
                    RowBox[{"i0", ",", "j0"}], "]"}], "]"}]}]}], "]"}], ")"}],

Cell[BoxData[
 RowBox[{
  RowBox[{"symbolicNashEquilibria", "[", 
   RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", ",", "n", ",", 
      RowBox[{"eqs", "=", 
       RowBox[{"{", "}"}]}], ",", "cond1", ",", "cond2", ",", "sol"}], "}"}], 
    ",", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m", ",", "n"}], "}"}], "=", 
      RowBox[{"Dimensions", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Do", "[", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"Player", " ", "1"}], ":", 
        RowBox[{
        "no", " ", "row", " ", "deviation", " ", "improves", " ", 
         "payoff"}]}], "*)"}], 
      RowBox[{
       RowBox[{
        RowBox[{"cond1", "=", 
         RowBox[{"And", "@@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"A", "[", 
              RowBox[{"[", 
               RowBox[{"i0", ",", "j0"}], "]"}], "]"}], ">=", 
             RowBox[{"A", "[", 
              RowBox[{"[", 
               RowBox[{"i", ",", "j0"}], "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "m"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"Player", " ", "2"}], ":", 
          RowBox[{
          "no", " ", "column", " ", "deviation", " ", "improves", " ", 
           "payoff"}]}], "*)"}], 
        RowBox[{"cond2", "=", 
         RowBox[{"And", "@@", 
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"B", "[", 
              RowBox[{"[", 
               RowBox[{"i0", ",", "j0"}], "]"}], "]"}], ">=", 
             RowBox[{"B", "[", 
              RowBox[{"[", 
               RowBox[{"i0", ",", "j"}], "]"}], "]"}]}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "n"}], "}"}]}], "]"}]}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"sol", "=", 
         RowBox[{"Reduce", "[", 
          RowBox[{
           RowBox[{"cond1", "&&", "cond2"}], ",", "assumptions"}], "]"}]}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{"sol", "=!=", "False"}], ",", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"eqs", ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i0", ",", "j0"}], "}"}], ",", "sol"}], "}"}]}], 
           "]"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"i0", ",", "m"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j0", ",", "n"}], "}"}]}], "]"}], ";", "\[IndentingNewLine]", 
     "eqs"}]}], "]"}]}]], "Input",ExpressionUUID->"7d1fe833-026d-4f40-b057-\
3c1918f95c2d"],


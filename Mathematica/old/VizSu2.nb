Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"VisualizeSO3", "[", 
    RowBox[{"\[Theta]_", ",", "\[Phi]_", ",", "\[Zeta]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"R", ",", "grid", ",", "transformed"}], "}"}], ",", 
     RowBox[{
      RowBox[{"R", "=", 
       RowBox[{"SU2toSO3", "[", 
        RowBox[{"\[Theta]", ",", "\[Phi]", ",", "\[Zeta]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"grid", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"x", ",", "y", ",", "z"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"x", ",", 
             RowBox[{"-", "1"}], ",", "1", ",", "0.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"y", ",", 
             RowBox[{"-", "1"}], ",", "1", ",", "0.5"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"z", ",", 
             RowBox[{"-", "1"}], ",", "1", ",", "0.5"}], "}"}]}], "]"}], ",", 
         "2"}], "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"transformed", "=", 
       RowBox[{
        RowBox[{
         RowBox[{"(", 
          RowBox[{"R", ".", "#"}], ")"}], "&"}], "/@", "grid"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"Graphics3D", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"Blue", ",", 
          RowBox[{"PointSize", "[", "Medium", "]"}], ",", 
          RowBox[{"Opacity", "[", ".3", "]"}], ",", 
          RowBox[{"Point", "/@", "grid"}], ",", "Red", ",", 
          RowBox[{"PointSize", "[", "Medium", "]"}], ",", 
          RowBox[{"Point", "/@", "transformed"}]}], "}"}], ",", 
        RowBox[{"Axes", "->", "True"}], ",", 
        RowBox[{"Boxed", "->", "False"}], ",", 
        RowBox[{"PlotRange", "->", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "2"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"-", "2"}], ",", "2"}], "}"}]}], "}"}]}]}], "]"}]}]}], 
    "]"}]}], "\n"}]], "Input",

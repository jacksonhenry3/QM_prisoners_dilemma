Cell[BoxData[
 RowBox[{
  RowBox[{"GraphicsGrid", "[", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"DensityPlot", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"alicesScores", "[", 
         RowBox[{"[", 
          RowBox[{"i", ",", "j"}], "]"}], "]"}], "/.", 
        RowBox[{"{", 
         RowBox[{"a", "->", "b"}], "}"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"b", ",", 
         RowBox[{"-", "10"}], ",", "10"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[Gamma]", ",", "0", ",", 
         FractionBox["Pi", "4"]}], "}"}], ",", 
       RowBox[{"RegionFunction", "->", 
        RowBox[{"Function", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"B", ",", "G", ",", "z"}], "}"}], ",", 
          RowBox[{
           RowBox[{
            RowBox[{"neConditionsAndSame", "[", 
             RowBox[{"[", "i", "]"}], "]"}], "[", 
            RowBox[{"[", "j", "]"}], "]"}], "/.", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"b", "->", "B"}], ",", 
             RowBox[{"\[Gamma]", "->", "G"}]}], "}"}]}]}], "]"}]}], ",", 
       RowBox[{"MaxRecursion", "->", "2"}], ",", 
       RowBox[{"Frame", "->", "False"}], ",", 
       RowBox[{"Ticks", "->", "None"}], ",", 
       RowBox[{"ColorFunction", "->", 
        RowBox[{"(", 
         RowBox[{
          RowBox[{"Blend", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"0", ",", "White"}], "}"}], ",", 
              RowBox[{"{", 
               RowBox[{"5", ",", "Blue"}], "}"}]}], "}"}], ",", "#"}], "]"}], 
          "&"}], ")"}]}], ",", 
       RowBox[{"ColorFunctionScaling", "->", "False"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "4"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"j", ",", "4"}], "}"}]}], "]"}], "]"}], "\n"}]], "Input",

Notebook[{
Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"generateTriplets", "[", "n_Integer", "]"}], ":=", 
    RowBox[{"Flatten", "[", 
     RowBox[{
      RowBox[{"Table", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{"i", " ", 
           FractionBox["\[Pi]", "n"]}], ",", 
          RowBox[{"j", " ", 
           RowBox[{"\[Pi]", "/", "n"}]}], ",", 
          RowBox[{"k", "*", "2", " ", 
           RowBox[{"Pi", "/", "n"}]}]}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"i", ",", "0", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j", ",", "0", ",", "n"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"k", ",", "0", ",", "n"}], "}"}]}], "]"}], ",", "2"}], 
     "]"}]}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"Example", ":", 
     RowBox[{
      RowBox[{"divisions", " ", "4", "\[Times]", "3", "\[Times]", "2"}], 
      "\[RightArrow]", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{"4", "+", "1"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"3", "+", "1"}], ")"}], "*", 
       RowBox[{"(", 
        RowBox[{"2", "+", "1"}], ")"}]}]}]}], "=", 
    RowBox[{"60", " ", "points"}]}], "*)"}]}], "\n", 
 RowBox[{
  RowBox[{"triplets1", "=", 
   RowBox[{"generateTriplets", "[", "5", "]"}]}], ";"}], "\n"}], "Input",
 CellChangeTimes->{{3.9548507483494797`*^9, 3.954850777585243*^9}, {
  3.954850857137377*^9, 3.9548508572394238`*^9}, {3.954851492112135*^9, 
  3.9548514922644424`*^9}, {3.954851673580885*^9, 3.95485167529525*^9}, {

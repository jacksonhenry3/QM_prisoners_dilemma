Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"-", 
    FractionBox["1", "2"]}], " ", 
   SuperscriptBox[
    RowBox[{"Cos", "[", 
     FractionBox["z2", "2"], "]"}], "2"], " ", 
   RowBox[{"(", 
    RowBox[{
     RowBox[{"-", "7"}], "+", 
     RowBox[{"Cos", "[", 
      RowBox[{"2", " ", "x1"}], "]"}], "+", 
     RowBox[{"2", " ", 
      RowBox[{"Cos", "[", "z1", "]"}], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "x1", "]"}], "2"]}]}], ")"}]}], "+", 
  RowBox[{
   RowBox[{"(", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       FractionBox["1", "2"]}], " ", 
      SuperscriptBox[
       RowBox[{"Cos", "[", "x2", "]"}], "2"], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"-", "7"}], "+", 
        RowBox[{"Cos", "[", 
         RowBox[{"2", " ", "x1"}], "]"}], "+", 
        RowBox[{"2", " ", 
         RowBox[{"Cos", "[", "z1", "]"}], " ", 
         SuperscriptBox[
          RowBox[{"Sin", "[", "x1", "]"}], "2"]}]}], ")"}]}], "+", 
     RowBox[{
      SuperscriptBox[
       RowBox[{"Sin", "[", "x1", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", "x2", "]"}], "2"], " ", 
      SuperscriptBox[
       RowBox[{"Sin", "[", 
        FractionBox["z1", "2"], "]"}], "2"]}]}], ")"}], " ", 
   SuperscriptBox[
    RowBox[{"Sin", "[", 
     FractionBox["z2", "2"], "]"}], "2"]}]}]], "Output",

Cell[BoxData[
 RowBox[{
  RowBox[{"commonOpts", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"ColorFunction", "->", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"Blend", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"0", ",", "White"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              FractionBox["5", "3"], ",", "Green"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"5", ",", "Blue"}], "}"}]}], "}"}], ",", "#"}], "]"}], 
        "&"}], ")"}]}], ",", 

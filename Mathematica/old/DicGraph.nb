Cell[BoxData[{
 RowBox[{
  RowBox[{"ClearAll", "[", "CuboidBetweenPoints", "]"}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CuboidBetweenPoints", "[", 
    RowBox[{
     RowBox[{"pts", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p1", ":", 
         RowBox[{"{", 
          RowBox[{"_", ",", "_", ",", "_"}], "}"}]}], ",", 
        RowBox[{"p2", ":", 
         RowBox[{"{", 
          RowBox[{"_", ",", "_", ",", "_"}], "}"}]}]}], "}"}]}], ",", 
     RowBox[{"side_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"ClearAll", "[", "CuboidBetweenPoints", "]"}]}], ";"}], "\n", 
 RowBox[{
  RowBox[{
   RowBox[{"CuboidBetweenPoints", "[", 
    RowBox[{
     RowBox[{"pts", ":", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"x1_", ",", "y1_", ",", "z1_"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"x2_", ",", "y2_", ",", "z2_"}], "}"}]}], "}"}]}], ",", 
     RowBox[{"side_", "?", "NumericQ"}]}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
      "p1", ",", "p2", ",", "cent", ",", "v", ",", "L", ",", "u", ",", "cub", 
       ",", "rot", ",", "trans", ",", "comp"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"p1", ",", "p2"}], "}"}], "=", "pts"}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"midpoint", " ", "and", " ", "vector"}], "*)"}], 
      RowBox[{"cent", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"p1", "+", "p2"}], ")"}], "/", "2"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"v", "=", 
       RowBox[{"p2", "-", "p1"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"L", "=", 
       RowBox[{"Norm", "[", "v", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"handle", " ", "the", " ", "degenerate", " ", "case"}], "*)"}], 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"L", "==", "0"}], ",", 
        RowBox[{"Return", "[", 
         RowBox[{"Cuboid", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{
              RowBox[{"-", "side"}], "/", "2"}], ",", 
             RowBox[{
              RowBox[{"-", "side"}], "/", "2"}], ",", 
             RowBox[{
              RowBox[{"-", "side"}], "/", "2"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"side", "/", "2"}], ",", 
             RowBox[{"side", "/", "2"}], ",", 
             RowBox[{"side", "/", "2"}]}], "}"}]}], "]"}], "]"}]}], "]"}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"u", "=", 
       RowBox[{"v", "/", "L"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"build", " ", "the", " ", "axis"}], "\[Hyphen]", 
        RowBox[{"aligned", " ", 
         RowBox[{
         "\[OpenCurlyDoubleQuote]", "unit", "\[CloseCurlyDoubleQuote]"}], " ",
          "cuboid", " ", "of", " ", "length", " ", "L", " ", "along", " ", 
         "the", " ", "x"}], "\[Hyphen]", "axis"}], "*)"}], 
      RowBox[{"cub", "=", 
       RowBox[{"Cuboid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{
            RowBox[{"-", "L"}], "/", "2"}], ",", 
           RowBox[{
            RowBox[{"-", "side"}], "/", "2"}], ",", 
           RowBox[{
            RowBox[{"-", "side"}], "/", "2"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"L", "/", "2"}], ",", 
           RowBox[{"side", "/", "2"}], ",", 
           RowBox[{"side", "/", "2"}]}], "}"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"rotation", " ", "taking", " ", 
         RowBox[{"{", 
          RowBox[{"1", ",", "0", ",", "0"}], "}"}]}], "\[RightArrow]", "u"}], 
       "*)"}], 
      RowBox[{"rot", "=", 
       RowBox[{"RotationTransform", "[", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"1", ",", "0", ",", "0"}], "}"}], ",", "u"}], "}"}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{"translation", " ", "to", " ", "the", " ", "midpoint"}], 
       "*)"}], 
      RowBox[{"trans", "=", 
       RowBox[{"TranslationTransform", "[", "cent", "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
        RowBox[{"compose", ":", 
         RowBox[{"first", " ", "rotate"}]}], ",", 
        RowBox[{"then", " ", "translate"}]}], "*)"}], 
      RowBox[{"comp", "=", 
       RowBox[{"trans", "@*", "rot"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "apply", " ", "the", " ", "single", " ", "composed", " ", 
        "transform"}], "*)"}], 
      RowBox[{"GeometricTransformation", "[", 
       RowBox[{"cub", ",", "comp"}], "]"}]}]}], "]"}]}], 
  "\n"}], "\n"}], "Input",
 CellChangeTimes->{{3.9551430092423344`*^9, 3.9551430548186493`*^9}, {
   3.9551431680569*^9, 3.955143171636814*^9}, 3.9551434430538235`*^9, {
   3.9551435761491394`*^9, 3.9551435801470394`*^9}, {3.955143639288803*^9, 
   3.955143639574749*^9}, {3.9551438023289375`*^9, 3.955143802597103*^9}, {
   3.955143845038435*^9, 3.9551438453427887`*^9}, {3.9551441318782024`*^9, 

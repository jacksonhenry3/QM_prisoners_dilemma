Cell[BoxData[
 RowBox[{"GeometricTransformation", "[", 
  RowBox[{
   RowBox[{"Cuboid", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", 
        FractionBox[
         SqrtBox["11"], "2"]}], ",", 
       RowBox[{"-", "0.25`"}], ",", 
       RowBox[{"-", "0.25`"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox[
        SqrtBox["11"], "2"], ",", "0.25`", ",", "0.25`"}], "}"}]}], "]"}], 
   ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", 
          SqrtBox["11"]], ",", 
         RowBox[{"-", 
          FractionBox["1", 
           SqrtBox["11"]]}], ",", 
         RowBox[{"-", 
          FractionBox["3", 
           SqrtBox["11"]]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["1", 
          SqrtBox["11"]], ",", 
         RowBox[{
          FractionBox["1", "110"], " ", 
          RowBox[{"(", 
           RowBox[{"99", "+", 
            SqrtBox["11"]}], ")"}]}], ",", 
         RowBox[{
          FractionBox["3", "110"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "11"}], "+", 
            SqrtBox["11"]}], ")"}]}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         FractionBox["3", 
          SqrtBox["11"]], ",", 
         RowBox[{
          FractionBox["3", "110"], " ", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"-", "11"}], "+", 
            SqrtBox["11"]}], ")"}]}], ",", 
         RowBox[{
          FractionBox["1", "110"], " ", 
          RowBox[{"(", 
           RowBox[{"11", "+", 
            RowBox[{"9", " ", 
             SqrtBox["11"]}]}], ")"}]}]}], "}"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       FractionBox["1", "2"], ",", 
       FractionBox["1", "2"], ",", 
       FractionBox["3", "2"]}], "}"}]}], "}"}]}], "]"}]], "Output",
 CellChangeTimes->{{3.9551430134712257`*^9, 3.9551430408102055`*^9}, 

Cell[BoxData[
 RowBox[{
  RowBox[{"CG", "[", 
   RowBox[{"G_List", ",", "S_List", ",", 
    RowBox[{"opts", ":", 
     RowBox[{"OptionsPattern", "[", "]"}]}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"gens", "=", "S"}], ",", "edges"}], "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{"build", " ", "edge", " ", 
      RowBox[{"list", ":", 
       RowBox[{"directed", " ", "or", " ", "undirected"}]}]}], "*)"}], 
    RowBox[{
     RowBox[{"edges", "=", 
      RowBox[{"(*", 
       RowBox[{"undirected", " ", "edges", " ", 
        RowBox[{"{", 
         RowBox[{"g", ",", 
          RowBox[{"g", ".", "s"}]}], "}"}], " ", "with", " ", "duplicates", 
        " ", "removed"}], "*)"}], 
      RowBox[{"DeleteDuplicates", "@", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"UndirectedEdge", "[", 
            RowBox[{"g", ",", 
             RowBox[{"s", " ", "g"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"g", ",", "G"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "gens"}], "}"}]}], "]"}], ",", "1"}], "]"}]}]}],
      ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"build", " ", "and", " ", "return", " ", "the", " ", "Graph"}], 
      "*)"}], 
     RowBox[{"Graph3D", "[", "edges", "]"}]}]}], "]"}]}]], "Input",

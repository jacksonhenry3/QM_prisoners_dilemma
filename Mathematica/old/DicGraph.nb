Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"1", ")"}], " ", "Clear", " ", "out", " ", "any", " ", "old", " ",
     "definitions", " ", "and", " ", "set", " ", "your", " ", "n"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{"c", ",", "x", ",", "n"}], "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"n", "=", "4"}], ";"}], "  ", 
   RowBox[{"(*", 
    RowBox[{"or", " ", "whatever", " ", "order", " ", "you", " ", "like"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"2", ")"}], " ", "Define", " ", 
     RowBox[{"C", "[", "i", "]"}], "*", 
     RowBox[{"C", "[", "j", "]"}], " ", "to", " ", "be", " ", "cyclic", " ", 
     "addition", " ", "mod", " ", "n"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"c", "/:", 
     RowBox[{"Times", "[", 
      RowBox[{
       RowBox[{"c", "[", "i_", "]"}], ",", 
       RowBox[{"c", "[", "j_", "]"}]}], "]"}], ":=", 
     RowBox[{"c", "[", 
      RowBox[{"Mod", "[", 
       RowBox[{
        RowBox[{"i", "+", "j"}], ",", 
        RowBox[{"2", "n"}], ",", "1"}], "]"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"3", ")"}], " ", "Make", " ", 
      RowBox[{"x", "^", "2"}]}], "=", 
     RowBox[{"C", "[", "n", "]"}]}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"x", "/:", 
     RowBox[{"Times", "[", 
      RowBox[{"x", ",", "x"}], "]"}], ":=", 
     RowBox[{"c", "[", "n", "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]"}]}]], "Input",

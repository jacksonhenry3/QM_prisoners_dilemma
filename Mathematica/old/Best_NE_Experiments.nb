Cell[BoxData[
 RowBox[{"ListAnimate", "[", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "matA", ",", "matB", ",", "m", ",", "n", ",", "neCells", ",", 
        "commonOpts", ",", "verticalLines", ",", "horizontalLines", ",", 
        "nashRects", ",", "ne", ",", "p"}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "Compute", " ", "payoff", " ", "matrices", " ", "and", " ", 
        "dimensions"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"Show", "[", 
       RowBox[{"Table", "[", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{
          RowBox[{"matA", "=", 
           RowBox[{"alicesScores", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"a", "->", "A"}], ",", 
              RowBox[{"b", "->", "0"}], ",", 
              RowBox[{"\[Gamma]", "->", "\[CapitalGamma]"}]}], "}"}]}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"matB", "=", 
           RowBox[{"bobsScores", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"a", "->", "A"}], ",", 
              RowBox[{"b", "->", "0"}], ",", 
              RowBox[{"\[Gamma]", "->", "\[CapitalGamma]"}]}], "}"}]}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"m", ",", "n"}], "}"}], "=", 
           RowBox[{"Dimensions", "[", "matA", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Find", " ", "pure", " ", "Nash", " ", "equilibria"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"ne", " ", "=", 
           RowBox[{"numericNashEquilibria", "[", 
            RowBox[{"matA", ",", "matB"}], "]"}]}], ";", " ", 
          "\[IndentingNewLine]", 
          RowBox[{"ListPlot", "[", 
           RowBox[{
            RowBox[{"ne", "[", 
             RowBox[{"[", 
              RowBox[{"All", ",", 
               RowBox[{"{", 
                RowBox[{"2", ",", "3"}], "}"}]}], "]"}], "]"}], ",", 
            RowBox[{"PlotRange", "->", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"0", ",", "4"}], "}"}], ",", 
               RowBox[{"{", 
                RowBox[{"0", ",", "4"}], "}"}]}], "}"}]}], ",", 
            RowBox[{"AspectRatio", "->", "1"}]}], "]"}]}], ",", 
         "\[IndentingNewLine]", 
         RowBox[{"{", 
          RowBox[{"\[CapitalGamma]", ",", "0", ",", 
           FractionBox["\[Pi]", "5"], ",", 
           FractionBox["\[Pi]", "100"]}], "}"}]}], "]"}], "]"}]}], 

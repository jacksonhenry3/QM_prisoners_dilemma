Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"s1", " ", "=", " ", "40"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s2", " ", "=", " ", "40"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"frames", " ", "=", " ", 
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"MatrixPlot", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
              "matA", ",", "matB", ",", "m", ",", "n", ",", "neCells", ",", 
               "commonOpts", ",", "verticalLines", ",", "horizontalLines", 
               ",", "nashRects", ",", "ne", ",", "bne"}], "}"}], ",", 
             RowBox[{"(*", 
              RowBox[{
              "Compute", " ", "payoff", " ", "matrices", " ", "and", " ", 
               "dimensions"}], "*)"}], 
             RowBox[{
              RowBox[{"matA", "=", 
               RowBox[{"alicesScores", "/.", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"a", "->", "A"}], ",", 
                  RowBox[{"b", "->", "B"}], ",", 
                  RowBox[{"\[Gamma]", "->", "\[CapitalGamma]"}]}], "}"}]}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{"matB", "=", 
               RowBox[{"bobsScores", "/.", " ", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"a", "->", "A"}], ",", 
                  RowBox[{"b", "->", "B"}], ",", 
                  RowBox[{"\[Gamma]", "->", "\[CapitalGamma]"}]}], "}"}]}]}], 
              ";", "\[IndentingNewLine]", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"m", ",", "n"}], "}"}], "=", 
               RowBox[{"Dimensions", "[", "matA", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"(*", 
               RowBox[{"Find", " ", "pure", " ", "Nash", " ", "equilibria"}], 
               "*)"}], "\[IndentingNewLine]", 
              RowBox[{"ne", " ", "=", 
               RowBox[{"numericNashEquilibria", "[", 
                RowBox[{
                 RowBox[{"matA", "//", "Chop"}], ",", 
                 RowBox[{"matB", "//", "Chop"}]}], "]"}]}], ";", " ", 
              "\[IndentingNewLine]", 
              RowBox[{"bne", " ", "=", " ", 
               RowBox[{"getBestNE", "[", "ne", "]"}]}], ";", 
              "\[IndentingNewLine]", 
              RowBox[{"If", "[", 
               RowBox[{
                RowBox[{
                 RowBox[{"Length", "[", "bne", "]"}], ">=", "2"}], ",", "\n", 
                RowBox[{"bne", "[", 
                 RowBox[{"[", "2", "]"}], "]"}], ",", 
                RowBox[{"-", "1"}]}], "]"}]}]}], "\n", "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"A", ",", "0.", ",", "10.", ",", 
             FractionBox["10.", "40"]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"B", ",", "0.", ",", "10.", ",", 
             FractionBox["10.", "40"]}], "}"}]}], "]"}], ",", 
         RowBox[{"ColorFunction", "->", "colorFunc"}], ",", 
         RowBox[{"ColorFunctionScaling", "->", "False"}], ",", 
         RowBox[{"PlotLegends", "->", 
          RowBox[{"BarLegend", "[", 
           RowBox[{"{", 
            RowBox[{"colorFunc", ",", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"-", "1"}], ",", "5"}], "}"}]}], "}"}], "]"}]}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalGamma]", ",", "0", ",", 
         FractionBox["\[Pi]", "5"], ",", 
         RowBox[{
          FractionBox["Pi", "2"], 
          FractionBox["1", "80"]}]}], "}"}]}], "]"}]}], ";"}]}]}]], "Input",

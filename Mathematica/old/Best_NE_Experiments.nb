Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"getBestNE", "[", "nes_", "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"sel", ",", "maxVal"}], "}"}], ",", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"sel", "=", 
       RowBox[{"Select", "[", 
        RowBox[{"nes", ",", 
         RowBox[{
          RowBox[{
           RowBox[{"#", "[", 
            RowBox[{"[", "2", "]"}], "]"}], "==", 
           RowBox[{"#", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], "&"}]}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Find", " ", "the", " ", "maximum", " ", "value", " ", "among", " ", 
        "the", " ", "second", " ", "numbers"}], "*)"}], "\n", 
      RowBox[{"maxVal", "=", 
       RowBox[{"Max", "[", 
        RowBox[{"sel", "[", 
         RowBox[{"[", 
          RowBox[{"All", ",", "2"}], "]"}], "]"}], "]"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"(*", 
       RowBox[{
       "Select", " ", "the", " ", "first", " ", "element", " ", "with", " ", 
        "that", " ", "maximum", " ", "value"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"sel", "===", 
         RowBox[{"{", "}"}]}], ",", 
        RowBox[{"{", "}"}], ",", "\n", 
        RowBox[{"First", "[", 
         RowBox[{"Select", "[", 
          RowBox[{"sel", ",", 
           RowBox[{
            RowBox[{
             RowBox[{"#", "[", 
              RowBox[{"[", "2", "]"}], "]"}], "==", "maxVal"}], "&"}]}], 
          "]"}], "]"}]}], "\[IndentingNewLine]", "]"}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{"getBestNE", "[", 
  RowBox[{"Flatten", "[", 
   RowBox[{
    RowBox[{"ParallelTable", "[", 
     RowBox[{
      RowBox[{"Module", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
         "matA", ",", "matB", ",", "m", ",", "n", ",", "neCells", ",", 
          "commonOpts", ",", "verticalLines", ",", "horizontalLines", ",", 
          "nashRects", ",", "ne", ","}], "}"}], ",", 
        RowBox[{"(*", 
         RowBox[{
         "Compute", " ", "payoff", " ", "matrices", " ", "and", " ", 
          "dimensions"}], "*)"}], 
        RowBox[{
         RowBox[{"matA", "=", 
          RowBox[{"alicesScores", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "->", "A"}], ",", 
             RowBox[{"b", "->", "A"}], ",", 
             RowBox[{"\[Gamma]", "->", "\[CapitalGamma]"}]}], "}"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"matB", "=", 
          RowBox[{"bobsScores", "/.", " ", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"a", "->", "A"}], ",", 
             RowBox[{"b", "->", "A"}], ",", 
             RowBox[{"\[Gamma]", "->", "\[CapitalGamma]"}]}], "}"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"m", ",", "n"}], "}"}], "=", 
          RowBox[{"Dimensions", "[", "matA", "]"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{"Find", " ", "pure", " ", "Nash", " ", "equilibria"}], 
          "*)"}], "\[IndentingNewLine]", 
         RowBox[{"ne", " ", "=", 
          RowBox[{"numericNashEquilibria", "[", 
           RowBox[{
            RowBox[{"matA", "//", "Chop"}], ",", 
            RowBox[{"matB", "//", "Chop"}]}], "]"}]}], ";", " ", "\n", 
         RowBox[{
          RowBox[{"getBestNE", "[", "ne", "]"}], "~", "Join", "~", 
          RowBox[{"{", 
           RowBox[{"A", ",", "\[CapitalGamma]"}], "}"}]}]}]}], "\n", "]"}], 
      ",", 
      RowBox[{"{", 
       RowBox[{"A", ",", "0.", ",", "10.", ",", 
        FractionBox["1", "10"]}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"\[CapitalGamma]", ",", "0", ",", 
        FractionBox["\[Pi]", "2"], ",", 
        RowBox[{
         FractionBox["\[Pi]", "2"], 
         FractionBox["1", "4"]}]}], "}"}]}], "]"}], ",", "1"}], "]"}], 
  "]"}]}], "Input",

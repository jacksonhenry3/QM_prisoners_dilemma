Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{"s1", " ", "=", " ", "200"}], ";"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"s2", " ", "=", " ", "100"}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"MatrixPlot", "[", 
    RowBox[{
     RowBox[{"ParallelTable", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "matA", ",", "matB", ",", "m", ",", "n", ",", "neCells", ",", 
           "commonOpts", ",", "verticalLines", ",", "horizontalLines", ",", 
           "nashRects", ",", "ne", ",", "bne"}], "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{
          "Compute", " ", "payoff", " ", "matrices", " ", "and", " ", 
           "dimensions"}], "*)"}], 
         RowBox[{
          RowBox[{"matA", "=", 
           RowBox[{"alicesScores", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"a", "->", "A"}], ",", 
              RowBox[{"b", "->", "A"}], ",", 
              RowBox[{"\[Gamma]", "->", "\[CapitalGamma]"}]}], "}"}]}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{"matB", "=", 
           RowBox[{"bobsScores", "/.", " ", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"a", "->", "A"}], ",", 
              RowBox[{"b", "->", "A"}], ",", 
              RowBox[{"\[Gamma]", "->", "\[CapitalGamma]"}]}], "}"}]}]}], ";",
           "\[IndentingNewLine]", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"m", ",", "n"}], "}"}], "=", 
           RowBox[{"Dimensions", "[", "matA", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"Find", " ", "pure", " ", "Nash", " ", "equilibria"}], 
           "*)"}], "\[IndentingNewLine]", 
          RowBox[{"ne", " ", "=", 
           RowBox[{"numericNashEquilibria", "[", 
            RowBox[{
             RowBox[{"matA", "//", "Chop"}], ",", 
             RowBox[{"matB", "//", "Chop"}]}], "]"}]}], ";", " ", 
          "\[IndentingNewLine]", 
          RowBox[{"bne", " ", "=", " ", 
           RowBox[{"getBestNE", "[", "ne", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"Length", "[", "bne", "]"}], ">=", "2"}], ",", "\n", 
            RowBox[{"bne", "[", 
             RowBox[{"[", "2", "]"}], "]"}], ",", 
            RowBox[{"-", "1"}]}], "]"}]}]}], "\n", "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"A", ",", 
         RowBox[{"-", "10"}], ",", "10.", ",", 
         FractionBox["10.", "s1"]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\[CapitalGamma]", ",", "0", ",", 
         FractionBox["\[Pi]", "2"], ",", 
         RowBox[{
          FractionBox["Pi", "2"], 
          FractionBox["1", "s2"]}]}], "}"}]}], "]"}], ",", 
     RowBox[{"PlotLegends", "->", "Automatic"}]}], "]"}]}]}]], "Input",

           RowBox[{
            RowBox[{"Log", "[", 
             RowBox[{"Sin", "[", "\[Gamma]", "]"}], "]"}], " ", 
            SuperscriptBox[
             RowBox[{"Sin", "[", "\[Gamma]", "]"}], "2"]}]}], ")"}]}], 

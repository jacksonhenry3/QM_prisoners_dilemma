        "dimensions"}], "*)"}], 
      RowBox[{
       RowBox[{"matA", "=", 
        RowBox[{"alicesScores", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"a", "->", "A"}], ",", 
           RowBox[{"b", "->", "A"}], ",", 
           RowBox[{"\[Gamma]", "->", "\[CapitalGamma]"}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 

       " ", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Common", " ", "plot", " ", "options", " ", "so", " ", "we", " ", 
         "only", " ", "set", " ", "them", " ", "once"}], "*)"}], 

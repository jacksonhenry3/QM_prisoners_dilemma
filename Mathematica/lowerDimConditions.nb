Notebook[{
Cell["\<\
First run the second half of the D4 notebook to find eq then run the following\
\>", "Text",
 CellChangeTimes->{{3.96764021751902*^9, 
  3.9676402510606823`*^9}},ExpressionUUID->"4206de25-56cb-6c4f-b88d-\
d61b34d34908"],

Cell[BoxData[
 RowBox[{
  RowBox[{"selectnD", "[", 
   RowBox[{"conds_", ",", "n_"}], "]"}], ":=", 
  RowBox[{"Select", "[", 
   RowBox[{"conds", ",", 
    RowBox[{
     RowBox[{
      RowBox[{"RegionDimension", "[", 
       RowBox[{"ImplicitRegion", "[", 
        RowBox[{"#", ",", 
         RowBox[{"{", 
          RowBox[{"a\[Prime]", ",", "\[Gamma]\[Prime]"}], "}"}]}], "]"}], 
       "]"}], "==", "n"}], "&"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.967631530405197*^9, 3.967631556165188*^9}, {
  3.967634376621559*^9, 3.967634382750618*^9}},
 CellLabel->
  "In[310]:=",ExpressionUUID->"97f22f4a-b9e2-f24f-826f-ae14a900905c"],

Cell[BoxData[
 RowBox[{
  RowBox[{"seperateOr", "[", "conds_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{
     RowBox[{"Head", "[", 
      RowBox[{"LogicalExpand", "[", "conds", "]"}], "]"}], "===", "Or"}], ",", 
    RowBox[{"List", "@@", 
     RowBox[{"LogicalExpand", "[", "conds", "]"}]}], ",", 
    RowBox[{"{", 
     RowBox[{"LogicalExpand", "[", "conds", "]"}], "}"}]}], "]"}]}]], "Input",
 CellChangeTimes->{{3.967631115714508*^9, 3.9676311322660275`*^9}},
 CellLabel->
  "In[311]:=",ExpressionUUID->"b489db38-7b80-824d-860d-9c1d253cbed4"],

Cell["\<\
This will take the values in eq, select out just the conditions (column 3) \
then seperate them in to distinct regions, then seperate them by \
dimensionality\
\>", "Text",
 CellChangeTimes->{{3.9676402582901306`*^9, 
  3.9676402994456177`*^9}},ExpressionUUID->"7effca45-670b-764c-8c3e-\
45b1de4c772d"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"rules", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"DeleteCases", "[", 
      RowBox[{
       RowBox[{
        RowBox[{
         RowBox[{"Reduce", "[", 
          RowBox[{"Simplify", "[", 
           RowBox[{
            RowBox[{"Reduce", "[", 
             RowBox[{"Simplify", "[", 
              RowBox[{"#", ",", "assumptions\[Prime]"}], "]"}], "]"}], ",", 
            "assumptions\[Prime]"}], "]"}], "]"}], "&"}], "/@", 
        RowBox[{"seperateOr", "[", 
         RowBox[{"e", "[", 
          RowBox[{"[", "3", "]"}], "]"}], "]"}]}], ",", "False"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"e", ",", "eq"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rules0D", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"selectnD", "[", 
      RowBox[{"r", ",", "0"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "rules"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rules1D", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"selectnD", "[", 
      RowBox[{"r", ",", "1"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "rules"}], "}"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"rules2D", " ", "=", " ", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"selectnD", "[", 
      RowBox[{"r", ",", "2"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"r", ",", "rules"}], "}"}]}], "]"}]}], ";"}]}], "Input",Expressi\
onUUID->"969278b5-1256-6944-b22d-75b85053e2b7"],


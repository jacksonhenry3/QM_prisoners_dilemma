Cell[CellGroupData[{
Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Ensure", " ", "your", " ", "payoff", " ", "functions", " ", 
    "aScoresComputed", " ", "and", " ", "bScoresComputed", " ", "are", " ", 
    "defined"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"For", " ", 
      RowBox[{"example", ":", "aScoresComputed"}]}], "=", 
     RowBox[{
      RowBox[{"...", " ", "your", " ", "expression"}], "..."}]}], ";"}], 
   "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{"bScoresComputed", "=", 
     RowBox[{
      RowBox[{"...", " ", "your", " ", "expression"}], "..."}]}], ";"}], 
   "*)"}], 
  RowBox[{"(*", 
   RowBox[{
   "1.", " ", "Define", " ", "your", " ", "variables", " ", "and", " ", "any",
     " ", "constants"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"varsA", "=", 
     RowBox[{"{", 
      RowBox[{"\[Theta]1", ",", "\[Phi]1", ",", "\[Zeta]1"}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"varsB", "=", 
     RowBox[{"{", 
      RowBox[{"\[Theta]2", ",", "\[Phi]2", ",", "\[Zeta]2"}], "}"}]}], ";"}], 
   "\n", 
   RowBox[{
    RowBox[{"allVars", "=", 
     RowBox[{"Join", "[", 
      RowBox[{"varsA", ",", "varsB"}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"\[Gamma]", "=", "0.760425"}], " ", ";"}], "\[IndentingNewLine]", 
   " ", 
   RowBox[{
    RowBox[{"a", "=", "0.571321"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Compute", " ", "the", " ", "gradients", " ", "for", " ", 
     "each", " ", "player"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gradA", "=", 
     RowBox[{"D", "[", 
      RowBox[{"aScoresComputed", ",", 
       RowBox[{"{", "varsA", "}"}]}], "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gradB", "=", 
     RowBox[{"D", "[", 
      RowBox[{"bScoresComputed", ",", 
       RowBox[{"{", "varsB", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
   "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "3.", " ", "Set", " ", "up", " ", "the", " ", "system", " ", "of", " ", 
     "equations"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"equations", "=", 
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"Join", "[", 
        RowBox[{"gradA", ",", "gradB"}], "]"}], "==", "0"}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "4.", " ", "Solve", " ", "the", " ", "system", " ", "numerically", " ", 
     "with", " ", "FindRoot"}], "*)"}], "\n", 
   RowBox[{"(*", 
    RowBox[{
    "You", " ", "MUST", " ", "provide", " ", "a", " ", "good", " ", 
     "starting", " ", "point", " ", "for", " ", "each", " ", 
     RowBox[{"variable", "."}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Define", " ", "all", " ", "the", " ", "variables", " ", "in", " ", 
     "your", " ", "system"}], "*)"}], 
   RowBox[{
    RowBox[{"allVars", "=", 
     RowBox[{"{", 
      RowBox[{
      "\[Theta]1", ",", "\[Phi]1", ",", "\[Zeta]1", ",", "\[Theta]2", ",", 
       "\[Phi]2", ",", "\[Zeta]2"}], "}"}]}], ";"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{"Optional", " ", "but", " ", "recommended"}], ")"}], " ", 
     "Make", " ", "the", " ", "randomization", " ", "reproducible"}], "*)"}], 
   "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"SeedRandom", "[", "1234", "]"}], ";"}], " ", "*)"}], 
   RowBox[{"(*", 
    RowBox[{"Use", " ", "any", " ", "integer", " ", "you", " ", "like"}], 
    "*)"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Generate", " ", "a", " ", "list", " ", "of", " ", "random", " ", 
     "values", " ", "between", " ", "0", " ", "and", " ", "2", "\[Pi]"}], 
    "*)"}], "\n", 
   RowBox[{
    RowBox[{"randomValues", "=", 
     RowBox[{"RandomReal", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"0", ",", 
         RowBox[{"2", " ", "Pi"}]}], "}"}], ",", 
       RowBox[{"Length", "[", "allVars", "]"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Combine", " ", "variables", " ", "and", " ", "values", " ", "into", " ", 
     "the", " ", 
     RowBox[{"{", 
      RowBox[{"var", ",", "start_val"}], "}"}], " ", "format"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"startPoint", "=", 
     RowBox[{"MapThread", "[", 
      RowBox[{"List", ",", 
       RowBox[{"{", 
        RowBox[{"allVars", ",", "randomValues"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"solution", "=", 
    RowBox[{"FindRoot", "[", 
     RowBox[{"equations", ",", "startPoint"}], "]"}]}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "The", " ", "output", " ", "will", " ", "be", " ", "a", " ", "set", " ", 
      "of", " ", "replacement", " ", "rules", " ", "for", " ", "the", " ", 
      "variables"}], ",", 
     RowBox[{"representing", " ", "a", " ", "candidate", " ", "Nash", " ", 
      RowBox[{"Equilibrium", "."}]}]}], "*)"}], "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"Assume", "'"}], 
      RowBox[{"solution", "'"}], " ", "is", " ", "the", " ", "output", " ", 
      "from", " ", "FindRoot"}], ",", 
     RowBox[{
      RowBox[{"e", ".", "g", "."}], ":"}]}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"solution", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"\[Theta]1", "->", "1.5"}], ",", 
        RowBox[{"\[Phi]1", "->", "0.8"}], ",", 
        RowBox[{"\[Zeta]1", "->", "2.1"}], ",", 
        RowBox[{"\[Theta]2", "->", "1.8"}], ",", 
        RowBox[{"\[Phi]2", "->", "0.5"}], ",", 
        RowBox[{"\[Zeta]2", "->", "2.5"}]}], "}"}]}], ";"}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"And", " ", "aScoresComputed"}], ",", "bScoresComputed", ",", 
     RowBox[{"\[Gamma]", " ", "are", " ", "defined"}]}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "1."}]}], " ", "Validation", " ", "for", " ", "Player", 
      " ", 
      RowBox[{"A", "--"}]}], "-"}], "*)"}], 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "Player", " ", 
     RowBox[{"A", "'"}], "s", " ", "variables"}], "*)"}], 
   RowBox[{
    RowBox[{"varsA", "=", 
     RowBox[{"{", 
      RowBox[{"\[Theta]1", ",", "\[Phi]1", ",", "\[Zeta]1"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "the", " ", "Hessian", " ", "matrix", " ", "for", " ", 
     "Player", " ", "A"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"hessianA", "=", 
     RowBox[{"D", "[", 
      RowBox[{"aScoresComputed", ",", 
       RowBox[{"{", 
        RowBox[{"varsA", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Substitute", " ", "the", " ", "candidate", " ", "NE", " ", "point", " ", 
     "into", " ", "the", " ", "Hessian"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"hessianAatNE", "=", 
     RowBox[{
      RowBox[{"hessianA", "/.", " ", "solution"}], "/.", " ", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]", "->", 
        RowBox[{"ArcSin", "[", 
         FractionBox["1", 
          SqrtBox["3"]], "]"}]}], "}"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Use", " ", "your", " ", "value", " ", "for", " ", "\[Gamma]"}], 
    "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "the", " ", "eigenvalues"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eigenvaluesA", "=", 
     RowBox[{"Eigenvalues", "[", "hessianAatNE", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<Player A Eigenvalues: \>\"", ",", "eigenvaluesA"}], "]"}], 
    ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{"eigenvaluesA", ",", 
        RowBox[{
         RowBox[{"#", "<", "0"}], "&"}]}], "]"}], ",", 
      RowBox[{"Print", "[", "\"\<--> Player A condition PASSED.\>\"", "]"}], 
      ",", 
      RowBox[{"Print", "[", "\"\<--> Player A condition FAILED.\>\"", "]"}]}],
      "]"}], ";"}], "\[IndentingNewLine]", "\[IndentingNewLine]", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "2."}]}], " ", "Validation", " ", "for", " ", "Player", 
      " ", 
      RowBox[{"B", "--"}]}], "-"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{"Define", " ", "Player", " ", 
     RowBox[{"B", "'"}], "s", " ", "variables"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"varsB", "=", 
     RowBox[{"{", 
      RowBox[{"\[Theta]2", ",", "\[Phi]2", ",", "\[Zeta]2"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "Compute", " ", "the", " ", "Hessian", " ", "matrix", " ", "for", " ", 
     "Player", " ", "B"}], "*)"}], "\n", 
   RowBox[{
    RowBox[{"hessianB", "=", 
     RowBox[{"D", "[", 
      RowBox[{"bScoresComputed", ",", 
       RowBox[{"{", 
        RowBox[{"varsB", ",", "2"}], "}"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "Substitute", " ", "the", " ", "candidate", " ", "NE", " ", "point", " ", 
     "into", " ", "the", " ", "Hessian"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"hessianBatNE", "=", 
     RowBox[{
      RowBox[{"hessianB", "/.", " ", "solution"}], "/.", " ", 
      RowBox[{"{", 
       RowBox[{"\[Gamma]", "->", "0.5"}], "}"}]}]}], ";"}], " ", 
   RowBox[{"(*", 
    RowBox[{"Use", " ", "your", " ", "value", " ", "for", " ", "\[Gamma]"}], 
    "*)"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Calculate", " ", "the", " ", "eigenvalues"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"eigenvaluesB", "=", 
     RowBox[{"Eigenvalues", "[", "hessianBatNE", "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{
    RowBox[{"Print", "[", 
     RowBox[{"\"\<\\nPlayer B Eigenvalues: \>\"", ",", "eigenvaluesB"}], 
     "]"}], ";"}], "\n", 
   RowBox[{
    RowBox[{"If", "[", 
     RowBox[{
      RowBox[{"AllTrue", "[", 
       RowBox[{"eigenvaluesB", ",", 
        RowBox[{
         RowBox[{"#", "<", "0"}], "&"}]}], "]"}], ",", 
      RowBox[{"Print", "[", "\"\<--> Player B condition PASSED.\>\"", "]"}], 
      ",", 
      RowBox[{"Print", "[", "\"\<--> Player B condition FAILED.\>\"", "]"}]}],
      "]"}], ";"}], "\[IndentingNewLine]", "\n", "\[IndentingNewLine]", 

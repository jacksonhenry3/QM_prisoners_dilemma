Cell[BoxData[{
 RowBox[{
  RowBox[{"play", "[", 
   RowBox[{"J_", ",", "d1_", ",", "d2_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{
      RowBox[{"ConjugateTranspose", "[", "J", "]"}], ".", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"KroneckerProduct", "[", 
         RowBox[{"d1", ",", "d2"}], "]"}], ".", 
        RowBox[{"(", 
         RowBox[{"J", ".", 
          RowBox[{"{", 
           RowBox[{"1", ",", "0", ",", "0", ",", "0"}], "}"}]}], ")"}]}], 
       ")"}]}], "//", "ComplexExpand"}], "//", "Simplify"}], "//", 
   "Chop"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"alicesScore", "[", "\[Psi]_", "]"}], ":=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 

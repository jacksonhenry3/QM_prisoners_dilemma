Cell[CellGroupData[{

Cell["Binary Tetrahedral group", "Subsection",
 CellChangeTimes->{{3.952238793426113*^9, 3.9522387992259407`*^9}, {
  3.9522397513987694`*^9, 
  3.9522397545370617`*^9}},ExpressionUUID->"68575565-a4d0-9449-9013-\
a5db1165414e"],

Cell[BoxData[
 RowBox[{"binaryTetrahedralGroup", ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
     "qi", ",", "qj", ",", "qk", ",", "q", ",", "epsilon", ",", "generators", 
      ",", "G", ",", "newElements", ",", "product", ",", "nextNew"}], "}"}], 
    ",", "\n", 
    RowBox[{"(*", 
     RowBox[{
     "Define", " ", "the", " ", "quaternion", " ", "representation", " ", 
      "via", " ", "2", "\[Times]", "2", " ", "complex", " ", "matrices"}], 
     "*)"}], "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{"qi", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"I", ",", "0"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"0", ",", 
          RowBox[{"-", "I"}]}], "}"}]}], "}"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"qj", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "1"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"-", "1"}], ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"qk", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"0", ",", "I"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"I", ",", "0"}], "}"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"q", "[", 
       RowBox[{"a_", ",", "b_", ",", "c_", ",", "d_"}], "]"}], ":=", 
      RowBox[{
       RowBox[{"a", " ", 
        RowBox[{"IdentityMatrix", "[", "2", "]"}]}], "+", 
       RowBox[{"b", " ", "qi"}], "+", 
       RowBox[{"c", " ", "qj"}], "+", 
       RowBox[{"d", " ", "qk"}]}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"Define", " ", 
        RowBox[{"generators", ":", "epsilon"}]}], "=", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"1", "+", "i", "+", "j", "+", "k"}], ")"}], "/", "2"}], 
         " ", "and", " ", "gen2"}], "=", 
        RowBox[{"i", " ", 
         RowBox[{"(", 
          RowBox[{"represented", " ", "by", " ", "qi"}], ")"}]}]}]}], "*)"}], 
     RowBox[{"epsilon", "=", 
      RowBox[{"q", "[", 
       RowBox[{
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{"1", "/", "2"}], ",", 
        RowBox[{"1", "/", "2"}]}], "]"}]}], ";", 
     RowBox[{"generators", "=", 
      RowBox[{"{", 
       RowBox[{"epsilon", ",", "qi"}], "}"}]}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "Compute", " ", "the", " ", "group", " ", "closure", " ", "starting", 
       " ", "from", " ", "the", " ", "identity"}], "*)"}], 
     "\[IndentingNewLine]", 
     RowBox[{"G", "=", 
      RowBox[{"{", 
       RowBox[{"IdentityMatrix", "[", "2", "]"}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"newElements", "=", "generators"}], ";", "\[IndentingNewLine]", 
     "\[IndentingNewLine]", 
     RowBox[{"While", "[", 
      RowBox[{
       RowBox[{"newElements", "!=", 
        RowBox[{"{", "}"}]}], ",", 
       RowBox[{
        RowBox[{"nextNew", "=", 
         RowBox[{"{", "}"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"Do", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"product", "=", 
              RowBox[{"Simplify", "[", 
               RowBox[{"g1", ".", "g2"}], "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"Not", "[", 
                RowBox[{"MemberQ", "[", 
                 RowBox[{"G", ",", "product"}], "]"}], "]"}], ",", 
               RowBox[{
                RowBox[{"AppendTo", "[", 
                 RowBox[{"nextNew", ",", "product"}], "]"}], ";", 

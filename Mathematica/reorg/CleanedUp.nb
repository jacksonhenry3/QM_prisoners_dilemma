Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{"symbolicNashEquilibria", "[", 
    RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"m", ",", "n", ",", 
       RowBox[{"eqs", "=", 
        RowBox[{"{", "}"}]}], ",", "cond1", ",", "cond2", ",", "sol"}], "}"}],
      ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"m", ",", "n"}], "}"}], "=", 
       RowBox[{"Dimensions", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Table", "[", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"Player", " ", "1"}], ":", 
         RowBox[{
         "no", " ", "row", " ", "deviation", " ", "improves", " ", 
          "payoff"}]}], "*)"}], 
       RowBox[{
        RowBox[{
         RowBox[{"cond1", "=", 
          RowBox[{"And", "@@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"A", "[", 
               RowBox[{"[", 
                RowBox[{"i0", ",", "j0"}], "]"}], "]"}], ">=", 
              RowBox[{"A", "[", 
               RowBox[{"[", 
                RowBox[{"i", ",", "j0"}], "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "m"}], "}"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"Player", " ", "2"}], ":", 
           RowBox[{
           "no", " ", "column", " ", "deviation", " ", "improves", " ", 
            "payoff"}]}], "*)"}], 
         RowBox[{"cond2", "=", 
          RowBox[{"And", "@@", 
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"B", "[", 
               RowBox[{"[", 
                RowBox[{"i0", ",", "j0"}], "]"}], "]"}], ">=", 
              RowBox[{"B", "[", 
               RowBox[{"[", 
                RowBox[{"i0", ",", "j"}], "]"}], "]"}]}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "n"}], "}"}]}], "]"}]}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"cond1", "&&", "cond2"}]}], ",", 
        RowBox[{"{", 
         RowBox[{"i0", ",", "m"}], "}"}], ",", 
        RowBox[{"{", 
         RowBox[{"j0", ",", "n"}], "}"}]}], "]"}]}]}], "]"}]}]}]], "Input",
 CellLabel->"In[28]:=",ExpressionUUID->"8b999014-c56f-dd4b-8eb5-9b329a8736bf"]

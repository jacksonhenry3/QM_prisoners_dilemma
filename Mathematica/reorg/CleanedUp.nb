        RowBox[{"Conjugate", "[", "\[Psi]", "]"}]}], ")"}], ".", 
      RowBox[{"{", 
       RowBox[{"3", ",", "0", ",", "5", ",", "1"}], "}"}]}], ")"}], "//", 
    "Chop"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{

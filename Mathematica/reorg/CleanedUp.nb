Cell[CellGroupData[{

Cell["Full SU2", "Subsection",
 CellChangeTimes->{{3.952238793426113*^9, 3.9522387992259407`*^9}, {
  3.9522388849881897`*^9, 3.952238888630131*^9}, {3.952239669010292*^9, 
  3.952239671411297*^9}},ExpressionUUID->"9e4fe6b9-cdb7-e744-afde-\
0b24c72bebca"],

Cell[BoxData[
 RowBox[{
  RowBox[{"su2", "[", 
   RowBox[{"\[Theta]_", ",", "\[Phi]_", ",", "\[Zeta]_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "n", "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{"(*", 
     RowBox[{
     "Define", " ", "the", " ", "unit", " ", "vector", " ", "using", " ", 
      "theta", " ", "and", " ", "phi"}], "*)"}], 
    RowBox[{
     RowBox[{"n", "=", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
         RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", 
        RowBox[{
         RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{"Construct", " ", "and", " ", "return", " ", "the", " ", "SU", 
       RowBox[{"(", "2", ")"}], " ", "matrix"}], "*)"}], 
     RowBox[{
      RowBox[{"MatrixExp", "[", 
       RowBox[{
        RowBox[{"-", "I"}], 
        FractionBox["\[Zeta]", "2"], 
        RowBox[{"n", ".", 
         RowBox[{"PauliMatrix", "[", 
          RowBox[{"{", 
           RowBox[{"1", ",", "2", ",", "3"}], "}"}], "]"}]}]}], "]"}], "//", 
      "Simplify"}]}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.9523333810942535`*^9, {3.9544115086548004`*^9, 3.9544115545888634`*^9}, {
   3.9544116081268444`*^9, 3.954411628716755*^9}},
 CellLabel->"In[9]:=",ExpressionUUID->"79ac72f9-0684-bb47-ba64-b25119426e77"],

Cell[BoxData[
 RowBox[{
  RowBox[{
   RowBox[{"so3", "[", 
    RowBox[{"\[Theta]_", ",", "\[Phi]_", ",", "\[Zeta]_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"nx", ",", "ny", ",", "nz", ",", "K"}], "}"}], ",", 
     RowBox[{
      RowBox[{
       RowBox[{"{", 
        RowBox[{"nx", ",", "ny", ",", "nz"}], "}"}], "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
          RowBox[{"Cos", "[", "\[Phi]", "]"}]}], ",", 
         RowBox[{
          RowBox[{"Sin", "[", "\[Theta]", "]"}], " ", 
          RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ",", 
         RowBox[{"Cos", "[", "\[Theta]", "]"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{"K", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"-", "nz"}], ",", "ny"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"nz", ",", "0", ",", 
           RowBox[{"-", "nx"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"-", "ny"}], ",", "nx", ",", "0"}], "}"}]}], "}"}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"IdentityMatrix", "[", "3", "]"}], "+", 
       RowBox[{
        RowBox[{"Sin", "[", "\[Zeta]", "]"}], " ", "K"}], "+", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "-", 
          RowBox[{"Cos", "[", "\[Zeta]", "]"}]}], ")"}], " ", 
        RowBox[{"K", ".", "K"}]}]}]}]}], "]"}]}], "\n"}]], "Input",
 CellChangeTimes->{{3.954411639040399*^9, 3.954411645735375*^9}, {
  3.9544117600968857`*^9, 3.95441176627606*^9}, {3.954411847061844*^9, 
  3.9544118749195385`*^9}},
 CellLabel->"In[8]:=",ExpressionUUID->"36b3ee14-777c-0044-9f5f-c7e19ca9e3c2"]
}, Open  ]],


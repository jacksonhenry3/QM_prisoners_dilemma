Cell[CellGroupData[{

Cell["Identifying Nash Equilibria", "Section",
 CellChangeTimes->{{3.9522386942660446`*^9, 3.9522387021646786`*^9}, 
   3.95224282345487*^9},ExpressionUUID->"21d39801-68e7-df41-9ff2-\
294dbf4ad9a8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"numericNashEquilibria", "[", 
   RowBox[{"A_", ",", "B_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"m", ",", "n", ",", "eqs"}], "}"}], ",", "\[IndentingNewLine]", 
    RowBox[{
     RowBox[{
      RowBox[{"{", 
       RowBox[{"m", ",", "n"}], "}"}], "=", 
      RowBox[{"Dimensions", "[", "A", "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"eqs", "=", 
      RowBox[{"Select", "[", 
       RowBox[{
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"i", ",", "j"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "m"}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{"j", ",", "n"}], "}"}]}], "]"}], ",", "1"}], "]"}], ",", 
        RowBox[{
         RowBox[{"With", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"i0", "=", 
              RowBox[{"#", "[", 
               RowBox[{"[", "1", "]"}], "]"}]}], ",", 
             RowBox[{"j0", "=", 
              RowBox[{"#", "[", 
               RowBox[{"[", "2", "]"}], "]"}]}]}], "}"}], ",", 
           RowBox[{
            RowBox[{"AllTrue", "[", 
             RowBox[{
              RowBox[{"Range", "[", "m", "]"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"#", "==", "i0"}], ",", "True", ",", 
                  RowBox[{
                   RowBox[{"A", "[", 
                    RowBox[{"[", 
                    RowBox[{"#", ",", "j0"}], "]"}], "]"}], "<=", 
                   RowBox[{"A", "[", 
                    RowBox[{"[", 
                    RowBox[{"i0", ",", "j0"}], "]"}], "]"}]}]}], "]"}], ")"}],
                "&"}]}], "]"}], "&&", 
            RowBox[{"AllTrue", "[", 
             RowBox[{
              RowBox[{"Range", "[", "n", "]"}], ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"If", "[", 
                 RowBox[{
                  RowBox[{"#", "==", "j0"}], ",", "True", ",", 
                  RowBox[{
                   RowBox[{"B", "[", 
                    RowBox[{"[", 
                    RowBox[{"i0", ",", "#"}], "]"}], "]"}], "<=", 
                   RowBox[{"B", "[", 
                    RowBox[{"[", 
                    RowBox[{"i0", ",", "j0"}], "]"}], "]"}]}]}], "]"}], ")"}],
                "&"}]}], "]"}]}]}], "]"}], "&"}]}], "]"}]}], ";", 
     "\[IndentingNewLine]", "eqs"}]}], "]"}]}]], "Input",
 CellChangeTimes->{
  3.952242631471546*^9, {3.95224266252023*^9, 3.952242666644764*^9}, {
   3.9522427122173824`*^9, 3.952242741959888*^9}, {3.9522428623154144`*^9, 

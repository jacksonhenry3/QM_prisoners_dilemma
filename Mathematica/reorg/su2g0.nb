Cell[BoxData[{
 RowBox[{
  RowBox[{"aliceVars", " ", "=", " ", 
   RowBox[{"{", 
    RowBox[{"\[Theta]1", ",", "\[Phi]1", ",", "\[Zeta]1"}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{" ", 
  RowBox[{
   RowBox[{"bobVars", " ", "=", " ", 
    RowBox[{"{", 
     RowBox[{"\[Theta]2", ",", "\[Phi]2", ",", "\[Zeta]2"}], "}"}]}], 
   ";"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aliceEquations", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"aScoresComputed", ",", "#"}], "]"}], "==", "0"}], ")"}], 
     "&"}], "/@", "aliceVars"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bobEquations", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"D", "[", 
        RowBox[{"bScoresComputed", ",", "#"}], "]"}], "==", "0"}], ")"}], 
     "&"}], "/@", "bobVars"}]}], ";"}]}], "Input",
 CellChangeTimes->{{3.96661345127424*^9, 3.966613482479412*^9}, {
  3.9666137344916267`*^9, 3.966613735292135*^9}, {3.9666140234551964`*^9, 

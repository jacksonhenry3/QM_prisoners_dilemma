Cell[BoxData[
 RowBox[{
  RowBox[{"constraints", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"1", "<=", "\[Theta]1", "<=", 
      SuperscriptBox["E", 
       RowBox[{"2", "\[Pi]"}]]}], ",", 
     RowBox[{"1", "<=", "\[Phi]1", "<=", 
      SuperscriptBox["E", 
       RowBox[{"2", "\[Pi]"}]]}], ",", 
     RowBox[{"0", "<=", "\[Zeta]1", "<=", "1"}], ",", 
     RowBox[{"1", "<=", "\[Theta]2", "<=", 

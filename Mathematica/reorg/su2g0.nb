         RowBox[{"1", "-", 
          SuperscriptBox["\[Zeta]2", "2"]}]], " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Phi]1", " ", "\[Phi]2"}], ")"}], 
         RowBox[{"-", "\[ImaginaryI]"}]]}]}
     },

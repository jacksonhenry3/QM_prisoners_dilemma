 CellLabel->"In[86]:=",ExpressionUUID->"4a593299-a6f7-8840-a602-84969c2528a3"],

Cell[TextData[{
 "Having made substitutions here the ranges are now\n",
 Cell[BoxData[
  FormBox[
   RowBox[{"\[Zeta]", "\[Element]", 
    RowBox[{"[", 
     RowBox[{"1", ",", "0"}], "]"}]}], TraditionalForm]],
  FormatType->TraditionalForm,ExpressionUUID->
  "514412f6-05d3-6d47-b2a4-ef3b30aafca7"],
 "\n\[Theta]\[Element][1,Exp[2\[Pi]])\n\[Phi]\[Element][1,Exp[2\[Pi]])"
}], "Text",

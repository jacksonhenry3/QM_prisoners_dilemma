Cell[BoxData[
 TagBox[
  RowBox[{"(", "\[NoBreak]", 
   TagBox[GridBox[{
      {
       RowBox[{"\[Zeta]1", " ", "\[Zeta]2", " ", 
        SuperscriptBox[
         RowBox[{"(", 
          RowBox[{"\[Theta]1", " ", "\[Theta]2"}], ")"}], "\[ImaginaryI]"]}]},
      {

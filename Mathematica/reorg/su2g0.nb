 CellLabel->"In[91]:=",ExpressionUUID->"8efbc393-72d3-154f-a940-9edf7e0558df"],

Cell[BoxData[{
 RowBox[{
  RowBox[{"allConditions", "=", 
   RowBox[{"Join", "[", 
    RowBox[{
     RowBox[{"aliceEquations", "//", "Simplify"}], ",", 
     RowBox[{"bobEquations", "//", "Simplify"}]}], "]"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"allVars", "=", 

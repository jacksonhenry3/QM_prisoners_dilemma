  "Out[105]=",ExpressionUUID->"bb7b20a0-c15e-a842-8c6c-69eb2a75e8ad"]
}, Open  ]],

Cell[BoxData[{
 RowBox[{
  RowBox[{"entanglementOperator", " ", "=", " ", 
   RowBox[{"FullSimplify", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"J", "[", 
       RowBox[{"0", ",", "0", ",", "0"}], "]"}], "//", "ExpToTrig"}], ",", 
     "constraints"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"finalState", " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"FullSimplify", "[", 
      RowBox[{
       RowBox[{"(", " ", 
        RowBox[{
         RowBox[{"play", "[", 
          RowBox[{"entanglementOperator", ",", 
           RowBox[{"su2", "[", 
            RowBox[{
             RowBox[{"Log", "[", "\[Theta]1", "]"}], ",", 
             RowBox[{"Log", "[", "\[Phi]1", "]"}], ",", 
             RowBox[{"ArcCos", "[", "\[Zeta]1", "]"}]}], "]"}], ",", 
           RowBox[{"su2", "[", 
            RowBox[{
             RowBox[{"Log", "[", "\[Theta]2", "]"}], ",", 
             RowBox[{"Log", "[", "\[Phi]2", "]"}], ",", 
             RowBox[{"ArcCos", "[", "\[Zeta]2", "]"}]}], "]"}]}], "]"}], "/.", 
         RowBox[{"Conjugate", "->", " ", "MyConj"}]}], ")"}], ",", 
       "constraints"}], "]"}], "//", "TrigToExp"}], "//", "FullSimplify"}]}], 
  ";"}]}], "Input",
 CellChangeTimes->{{3.966344477048104*^9, 3.9663444818103504`*^9}, {
   3.966344699422993*^9, 3.9663447038699512`*^9}, {3.966612271503603*^9, 
   3.966612279955284*^9}, 3.966620072306008*^9, {3.966620736654257*^9, 
   3.966620740285816*^9}, {3.96662088844359*^9, 3.9666208921199074`*^9}, {
   3.966621318941662*^9, 3.966621320119152*^9}, {3.966622123106527*^9, 
   3.966622158926293*^9}, {3.966623991453571*^9, 3.966623998365511*^9}, {
   3.966716692046427*^9, 3.966716693453654*^9}, {3.966718947224741*^9, 
   3.966718989971641*^9}, {3.96671915327853*^9, 3.9667191581403036`*^9}, {
   3.966719346881232*^9, 3.966719358619349*^9}, {3.966755637872116*^9, 

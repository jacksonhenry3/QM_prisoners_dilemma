 CellLabel->"In[83]:=",ExpressionUUID->"76dd34e3-4a3a-3a4c-a5aa-697897b6ec36"],

Cell["\<\
The standard ranges of the angles of su2[\[Theta],\[Phi],\[Zeta]] are
\[Zeta]\[Element][0,\[Pi]/2]
\[Theta]\[Element][0,2\[Pi])
\[Phi]\[Element][0,2\[Pi])\
\>", "Text",
 CellChangeTimes->{{3.966760793242174*^9, 
  3.966760834903099*^9}},ExpressionUUID->"86ab40fb-9e82-b440-a2cd-\
bd4e82f65d47"],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"ArcCos", "[", "1", "]"}]], "Input",
 CellChangeTimes->{{3.971865657434389*^9, 3.9718656819838066`*^9}},
 CellLabel->
  "In[105]:=",ExpressionUUID->"921d51c7-c3ac-054a-a1ed-251e4d0ff5c0"],


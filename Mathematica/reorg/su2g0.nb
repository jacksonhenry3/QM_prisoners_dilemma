     RowBox[{"0", "<=", "\[Zeta]2", "<=", "1"}], ",", 
     RowBox[{"0", "<", "\[Gamma]", "<", 
      FractionBox["Pi", "2"]}]}], "}"}]}], ";"}]], "Input",

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{"eg", "[", 
  RowBox[{"a", ",", "b", ",", "c"}], "]"}]], "Input",
 CellChangeTimes->{{3.9607058721158123`*^9, 3.9607058740651016`*^9}},
 CellLabel->
  "In[106]:=",ExpressionUUID->"72a307b3-2995-1a49-9dbd-543676d510b3"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"Cos", "[", "a", "]"}], ",", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "\[ImaginaryI]"}], " ", 
        RowBox[{"(", 
         RowBox[{"b", "-", "c"}], ")"}]}]], " ", 
      RowBox[{"Sin", "[", "a", "]"}]}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"-", 
       SuperscriptBox["\[ExponentialE]", 
        RowBox[{
         RowBox[{"-", "\[ImaginaryI]"}], " ", 
         RowBox[{"(", 
          RowBox[{"b", "+", "c"}], ")"}]}]]}], " ", 
      RowBox[{"Sin", "[", "a", "]"}]}], ",", 
     RowBox[{
      SuperscriptBox["\[ExponentialE]", 
       RowBox[{
        RowBox[{"-", "2"}], " ", "\[ImaginaryI]", " ", "b"}]], " ", 
      RowBox[{"Cos", "[", "a", "]"}]}]}], "}"}]}], "}"}]], "Output",
 CellChangeTimes->{3.960705874450573*^9, 3.9607066720630455`*^9},
 CellLabel->
  "Out[106]=",ExpressionUUID->"b2db16b6-b80c-464a-8191-217e43817f6e"]
}, Open  ]],

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(", 
   RowBox[{
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Re", "[", "#", "]"}], ",", 
       RowBox[{"Im", "[", "#", "]"}]}], "}"}], "&"}], "/@", 

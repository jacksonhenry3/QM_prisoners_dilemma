Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"findNashEquilibrium", "::", "usage"}], "=", 
   "\"\<findNashEquilibrium[aliceScore, bobScore, opts] finds a validated \
local Nash Equilibrium.\n  It checks the equilibrium condition numerically \
using FindMaximum.\>\""}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "The", " ", "local", " ", "solver", " ", "from", " ", "our", " ", "last", 
    " ", 
    RowBox[{"conversation", ".", "It"}], " ", "checks", " ", "a", " ", 
    "single", " ", "start", " ", 
    RowBox[{"point", "."}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"findNashEquilibrium", "[", 
     RowBox[{"aliceScore_Function", ",", "bobScore_Function", ",", 
      RowBox[{"opts___", "?", "OptionQ"}]}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "p1vars", ",", "p2vars", ",", "allvars", ",", "gradA", ",", "gradB", 
        ",", "focs", ",", "startPoint", ",", "criticalPoint", ",", 
        "aliceVarsAtCrit", ",", "bobVarsAtCrit", ",", "aliceCheck", ",", 
        "bobCheck", ",", "isNash"}], "}"}], ",", 
      RowBox[{
       RowBox[{"p1vars", "=", 
        RowBox[{"{", 
         RowBox[{"th1", ",", "ph1", ",", "z1"}], "}"}]}], ";", 
       RowBox[{"p2vars", "=", 
        RowBox[{"{", 
         RowBox[{"th2", ",", "ph2", ",", "z2"}], "}"}]}], ";", 
       RowBox[{"allvars", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"p1vars", ",", "p2vars"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"startPoint", "=", 
        RowBox[{
         RowBox[{"\"\<StartPoint\>\"", "/.", " ", 
          RowBox[{"{", "opts", "}"}]}], "/.", " ", 
         RowBox[{"{", 
          RowBox[{"\"\<StartPoint\>\"", "->", 
           RowBox[{"RandomReal", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"2", " ", "Pi"}]}], "}"}], ",", "6"}], "]"}]}], 
          "}"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"gradA", "=", 
        RowBox[{"Grad", "[", 
         RowBox[{
          RowBox[{"aliceScore", "[", 
           RowBox[{
           "th1", ",", "ph1", ",", "z1", ",", "th2", ",", "ph2", ",", "z2"}], 
           "]"}], ",", "p1vars"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"gradB", "=", 
        RowBox[{"Grad", "[", 
         RowBox[{
          RowBox[{"bobScore", "[", 
           RowBox[{
           "th1", ",", "ph1", ",", "z1", ",", "th2", ",", "ph2", ",", "z2"}], 
           "]"}], ",", "p2vars"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"focs", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{"gradA", "==", "0"}], "]"}], ",", 
          RowBox[{"Thread", "[", 
           RowBox[{"gradB", "==", "0"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"criticalPoint", "=", 
        RowBox[{"Quiet", "@", 
         RowBox[{"Check", "[", 
          RowBox[{
           RowBox[{"FindRoot", "[", 
            RowBox[{"focs", ",", 
             RowBox[{"Transpose", "[", 
              RowBox[{"{", 
               RowBox[{"allvars", ",", "startPoint"}], "}"}], "]"}]}], "]"}], 
           ",", "$Failed"}], "]"}]}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{
          RowBox[{"criticalPoint", "===", "$Failed"}], "||", 
          RowBox[{"Not", "[", 
           RowBox[{
            RowBox[{"And", "@@", 
             RowBox[{"Thread", "[", 
              RowBox[{"0", "<=", "allvars", "<=", 
               RowBox[{"2", " ", "Pi"}]}], "]"}]}], "/.", " ", 
            "criticalPoint"}], "]"}]}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"aliceVarsAtCrit", "=", 
        RowBox[{"p1vars", "/.", " ", "criticalPoint"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"bobVarsAtCrit", "=", 
        RowBox[{"p2vars", "/.", " ", "criticalPoint"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"aliceCheck", "=", 
        RowBox[{"FindMaximum", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"aliceScore", "[", 
             RowBox[{"th1", ",", "ph1", ",", "z1", ",", 
              RowBox[{"Sequence", "@@", "bobVarsAtCrit"}]}], "]"}], ",", 
            RowBox[{"And", "@@", 
             RowBox[{"Thread", "[", 
              RowBox[{"0", "<=", "p1vars", "<=", 
               RowBox[{"2", " ", "Pi"}]}], "]"}]}]}], "}"}], ",", 
          RowBox[{"Evaluate", "[", 
           RowBox[{"Sequence", "@@", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"p1vars", ",", "aliceVarsAtCrit"}], "}"}], "]"}]}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"bobCheck", "=", 
        RowBox[{"FindMaximum", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"bobScore", "[", 
             RowBox[{
              RowBox[{"Sequence", "@@", "aliceVarsAtCrit"}], ",", "th2", ",", 
              "ph2", ",", "z2"}], "]"}], ",", 
            RowBox[{"And", "@@", 
             RowBox[{"Thread", "[", 
              RowBox[{"0", "<=", "p2vars", "<=", 
               RowBox[{"2", " ", "Pi"}]}], "]"}]}]}], "}"}], ",", 
          RowBox[{"Evaluate", "[", 
           RowBox[{"Sequence", "@@", 
            RowBox[{"Transpose", "[", 
             RowBox[{"{", 
              RowBox[{"p2vars", ",", "bobVarsAtCrit"}], "}"}], "]"}]}], 
           "]"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"isNash", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"First", "[", "aliceCheck", "]"}], "-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"aliceScore", "[", "##", "]"}], "&"}], "@@", 
               RowBox[{"Join", "[", 
                RowBox[{"aliceVarsAtCrit", ",", "bobVarsAtCrit"}], "]"}]}], 
              ")"}]}], "]"}], "<", "1*^-6"}], ")"}], "&&", 
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Abs", "[", 
            RowBox[{
             RowBox[{"First", "[", "bobCheck", "]"}], "-", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"bobScore", "[", "##", "]"}], "&"}], "@@", 
               RowBox[{"Join", "[", 
                RowBox[{"aliceVarsAtCrit", ",", "bobVarsAtCrit"}], "]"}]}], 
              ")"}]}], "]"}], "<", "1*^-6"}], ")"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{"isNash", ",", 
         RowBox[{"Return", "[", "criticalPoint", "]"}], ",", 
         RowBox[{"Return", "[", "$Failed", "]"}]}], "]"}]}]}], "]"}]}], ";"}],
   "\n", "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{
   "The", " ", "grid", " ", "search", " ", "wrapper", " ", "function"}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{
    RowBox[{"gridSearchNash", "::", "usage"}], "=", 
    "\"\<gridSearchNash[aliceScore, bobScore, n] performs a grid search for \
Nash Equilibria.\n  - n: The number of grid points for each of the 6 \
dimensions. Total checks = n^6.\>\""}], ";"}], "\[IndentingNewLine]"}], "\n", 
 RowBox[{
  RowBox[{"gridSearchNash", "[", 
   RowBox[{"aliceScore_Function", ",", "bobScore_Function", ",", 
    RowBox[{"n_Integer", "?", "Positive"}]}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"gridPoints", ",", "results", ",", "uniqueSolutions"}], "}"}], 
    ",", 
    RowBox[{"(*", 
     RowBox[{
     "1.", " ", "Generate", " ", "the", " ", "grid", " ", "of", " ", 
      "starting", " ", "points"}], "*)"}], 
    RowBox[{
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"n", "==", "1"}], ",", 
       RowBox[{"gridPoints", "=", 
        RowBox[{"{", 
         RowBox[{"Table", "[", 
          RowBox[{"Pi", ",", 
           RowBox[{"{", "6", "}"}]}], "]"}], "}"}]}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "Special", " ", "case", " ", "for", " ", "a", " ", "single", " ", 
         "central", " ", "point"}], "*)"}], 
       RowBox[{"gridPoints", "=", 
        RowBox[{"Tuples", "[", 
         RowBox[{
          RowBox[{"Subdivide", "[", 
           RowBox[{"0", ",", 
            RowBox[{"2", " ", "Pi"}], ",", 
            RowBox[{"n", "-", "1"}]}], "]"}], ",", "6"}], "]"}]}]}], "]"}], 
     ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Generated \>\"", ",", 
       RowBox[{"Length", "[", "gridPoints", "]"}], ",", 
       "\"\< starting points for the grid search.\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "2.", " ", "Run", " ", "the", " ", "local", " ", "solver", " ", "from", 
       " ", "each", " ", "point", " ", "in", " ", "parallel"}], "*)"}], 
     RowBox[{"results", "=", 
      RowBox[{"ParallelMap", "[", 
       RowBox[{
        RowBox[{
         RowBox[{"findNashEquilibrium", "[", 
          RowBox[{"aliceScore", ",", "bobScore", ",", 
           RowBox[{"StartPoint", "->", "#"}]}], "]"}], "&"}], ",", 
        "gridPoints"}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
      "3.", " ", "Filter", " ", "out", " ", "failures", " ", "and", " ", 
       "remove", " ", "duplicate", " ", "solutions"}], "*)"}], 
     RowBox[{"uniqueSolutions", "=", 
      RowBox[{"DeleteDuplicates", "[", 
       RowBox[{
        RowBox[{"Select", "[", 
         RowBox[{"results", ",", 
          RowBox[{
           RowBox[{"#", "=!=", "$Failed"}], "&"}]}], "]"}], ",", 
        RowBox[{"(*", 
         RowBox[{
         "Two", " ", "solutions", " ", "are", " ", "considered", " ", 
          "duplicates", " ", "if", " ", "their", " ", "points", " ", "are", 
          " ", "very", " ", "close"}], "*)"}], 
        RowBox[{
         RowBox[{"(", 
          RowBox[{
           RowBox[{"Norm", "[", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Values", "[", "#1", "]"}], "-", 
              RowBox[{"Values", "[", "#2", "]"}]}], ")"}], "]"}], "<", 
           "1*^-4"}], ")"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
     RowBox[{"Print", "[", 
      RowBox[{"\"\<Found \>\"", ",", 
       RowBox[{"Length", "[", "uniqueSolutions", "]"}], ",", 
       "\"\< unique Nash Equilibria.\>\""}], "]"}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"Return", "[", "uniqueSolutions", "]"}], ";"}]}], 
   "]"}]}]}], "Input",
 CellChangeTimes->{{3.962290659184864*^9, 3.962290659184864*^9}, {
   3.9622909053948345`*^9, 3.962290905773651*^9}, {3.9622909796537704`*^9, 

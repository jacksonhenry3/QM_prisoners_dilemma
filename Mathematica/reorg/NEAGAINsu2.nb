                  RowBox[{"{", 
                   RowBox[{"Red", ",", 
                    RowBox[{"PointSize", "[", "Large", "]"}], ",", 
                    RowBox[{"Point", "[", "aMovePoint", "]"}]}], "}"}]}], 
                 "}"}], "]"}]}], "]"}], ",", 
             RowBox[{"(*", 
              RowBox[{

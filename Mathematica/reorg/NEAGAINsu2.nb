Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Mathematica", " ", "function", " ", "to", " ", "find", " ", "pure"}], 
    "-", 
    RowBox[{
    "strategy", " ", "Nash", " ", "Equilibria", " ", "in", " ", "a", " ", 
     "continuous", " ", "game", " ", "where", " ", "each", " ", "player", " ",
      "has", " ", "a", " ", "two"}], "-", 
    RowBox[{"dimensional", " ", "strategy", " ", 
     RowBox[{"space", ".", 
      RowBox[{"Author", ":", 
       RowBox[{"Gemini", " ", "Date"}], ":", 
       RowBox[{"2024", "-", "07", "-", "03"}]}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"ClearAll", "[", 
     RowBox[{
     "findContinuousNashEquilibria", ",", "ascore", ",", "bscore", ",", 
      "amove", ",", "bmove"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"findContinuousNashEquilibria", "[", 
       RowBox[{
       "ascoreFunc_", ",", "bscoreFunc_", ",", "amoveVars_", ",", 
        "bmoveVars_"}], "]"}], " ", "Finds", " ", "Nash", " ", "Equilibria", 
      " ", 
      RowBox[{"by", ":", 
       RowBox[{
       "1.", " ", "Calculating", " ", "the", " ", "gradient", " ", "of", " ", 
        "each", " ", 
        RowBox[{"player", "'"}], "s", " ", "score", " ", "function", " ", 
        "with", " ", "respect", " ", "to", " ", "their", " ", "own", " ", 
        "strategy", " ", 
        RowBox[{"variables", ".", "2."}], " ", "Setting", " ", "the", " ", 
        "resulting", " ", "partial", " ", "derivatives", " ", "to", " ", 
        "zero", " ", "to", " ", "form", " ", "a", " ", "system", " ", "of", 
        " ", "equations", " ", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"First", "-", 
           RowBox[{"Order", " ", "Conditions"}]}], ")"}], ".", "3."}], " ", 
        "Solving", " ", "this", " ", "system", " ", "to", " ", "find", " ", 
        "candidate", " ", "points", " ", "for", " ", 
        RowBox[{"equilibria", ".", "4."}], " ", "For", " ", "each", " ", 
        "candidate"}]}]}], ",", 
     RowBox[{
      RowBox[{
      "calculating", " ", "the", " ", "Hessian", " ", "matrix", " ", "for", 
       " ", "each", " ", 
       RowBox[{"player", ".", "5."}], " ", "Checking", " ", "if", " ", "the", 
       " ", "Hessians", " ", "are", " ", "negative", " ", "semi"}], "-", 
      RowBox[{
      "definite", " ", "to", " ", "ensure", " ", "the", " ", "point", " ", 
       "is", " ", "a", " ", "local", " ", "maximum", " ", "for", " ", "each", 
       " ", "player", " ", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"Second", "-", 
          RowBox[{"Order", " ", "Conditions"}]}], ")"}], ".", 
        RowBox[{"Arguments", ":", 
         RowBox[{"-", "ascoreFunc"}], ":", 
         RowBox[{"Player", " ", 
          RowBox[{"A", "'"}], "s", " ", "score", " ", 
          RowBox[{"function", ".", "E", ".", "g", "."}]}]}]}]}]}], ",", 
     RowBox[{
      RowBox[{"ascore", "[", 
       RowBox[{"amove", ",", "bmove"}], "]"}], "-", 
      RowBox[{"bscoreFunc", ":", 
       RowBox[{"Player", " ", 
        RowBox[{"B", "'"}], "s", " ", "score", " ", 
        RowBox[{"function", ".", "E", ".", "g", "."}]}]}]}], ",", 
     RowBox[{
      RowBox[{"bscore", "[", 
       RowBox[{"amove", ",", "bmove"}], "]"}], "-", 
      RowBox[{"amoveVars", ":", 
       RowBox[{"A", " ", "list", " ", "of", " ", "Player", " ", 
        RowBox[{"A", "'"}], "s", " ", "strategy", " ", 
        RowBox[{"variables", ".", "E", ".", "g", "."}]}]}]}], ",", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"ax", ",", "ay"}], "}"}], "-", 
      RowBox[{"bmoveVars", ":", 
       RowBox[{"A", " ", "list", " ", "of", " ", "Player", " ", 
        RowBox[{"B", "'"}], "s", " ", "strategy", " ", 
        RowBox[{"variables", ".", "E", ".", "g", "."}]}]}]}], ",", 
     RowBox[{"{", 
      RowBox[{"bx", ",", "by"}], "}"}]}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"findContinuousNashEquilibria", "[", 
      RowBox[{
      "ascoreFunc_", ",", "bscoreFunc_", ",", "amoveVars_List", ",", 
       "bmoveVars_List"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"vars", "=", 
          RowBox[{"Join", "[", 
           RowBox[{"amoveVars", ",", "bmoveVars"}], "]"}]}], ",", "gradA", 
         ",", "gradB", ",", "equations", ",", "candidates", ",", "hessianA", 
         ",", "hessianB", ",", "isMaxA", ",", "isMaxB", ",", 
         RowBox[{"equilibria", "=", 
          RowBox[{"{", "}"}]}], ",", "constraints"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"1.", " ", "Find", " ", "First"}], "-", 
         RowBox[{"Order", " ", "Conditions", " ", 
          RowBox[{"(", "FOCs", ")"}]}]}], "*)"}], 
       RowBox[{
        RowBox[{
        "Print", "[", "\"\<1. Calculating First-Order Conditions...\>\"", 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"gradA", "=", 
         RowBox[{"D", "[", 
          RowBox[{"ascoreFunc", ",", 
           RowBox[{"{", 
            RowBox[{"amoveVars", ",", "1"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"gradB", "=", 
         RowBox[{"D", "[", 
          RowBox[{"bscoreFunc", ",", 
           RowBox[{"{", 
            RowBox[{"bmoveVars", ",", "1"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"equations", "=", 
         RowBox[{
          RowBox[{"Join", "[", 
           RowBox[{
            RowBox[{"Thread", "[", 
             RowBox[{"gradA", "==", "0"}], "]"}], ",", 
            RowBox[{"Thread", "[", 
             RowBox[{"gradB", "==", "0"}], "]"}]}], "]"}], "//", 
          "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"constraints", "=", 
         RowBox[{"And", "@@", 
          RowBox[{"Thread", "[", 
           RowBox[{"0", "<=", 
            RowBox[{"Join", "[", 
             RowBox[{"amoveVars", ",", "bmoveVars"}], "]"}], "<=", 
            RowBox[{"2", " ", "Pi"}]}], "]"}]}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "\"\<System of equations to solve:\>\"", "]"}], 
        ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"MatrixForm", "[", "equations", "]"}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
         "2.", " ", "Solve", " ", "the", " ", "system", " ", "for", " ", 
          "candidate", " ", "points"}], "*)"}], 
        RowBox[{
        "Print", "[", "\"\<\\n2. Solving for candidate equilibria...\>\"", 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{
          "Using", " ", "Reduce", " ", "for", " ", "a", " ", "general", " ", 
           "symbolic", " ", 
           RowBox[{"solution", ".", "For"}], " ", "purely", " ", "numerical", 
           " ", "results"}], ",", 
          RowBox[{"NSolve", " ", "could", " ", "be", " ", 
           RowBox[{"used", "."}]}]}], "*)"}], 
        RowBox[{"candidates", "=", 
         RowBox[{"Solve", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"And", "@@", "equations"}], "&&", "constraints"}], ",", 
           "vars", ",", "Reals"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"If", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"Length", "[", "candidates", "]"}], "==", "0"}], ",", 
          RowBox[{
           RowBox[{
           "Print", "[", 
            "\"\<No real solutions found for the first-order conditions.\>\"",
             "]"}], ";", "\[IndentingNewLine]", 
           RowBox[{"Return", "[", 
            RowBox[{"{", "}"}], "]"}], ";"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Print", "[", 
         RowBox[{"\"\<Found \>\"", ",", 
          RowBox[{"Length", "[", "candidates", "]"}], ",", 
          "\"\< candidate(s):\>\""}], "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Print", "[", "candidates", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{
          RowBox[{"3.", " ", "Check", " ", "Second"}], "-", 
          RowBox[{"Order", " ", "Conditions", " ", 
           RowBox[{"(", "SOCs", ")"}], " ", "for", " ", "each", " ", 
           "candidate"}]}], "*)"}], 
        RowBox[{
        "Print", "[", 
         "\"\<\\n3. Checking Second-Order Conditions (verifying \
maxima)...\>\"", "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"hessianA", "=", 
         RowBox[{"D", "[", 
          RowBox[{"ascoreFunc", ",", 
           RowBox[{"{", 
            RowBox[{"amoveVars", ",", "2"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"hessianB", "=", 
         RowBox[{"D", "[", 
          RowBox[{"bscoreFunc", ",", 
           RowBox[{"{", 
            RowBox[{"bmoveVars", ",", "2"}], "}"}]}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"Do", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"currentCandidateRules", "=", "candidate"}], ",", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<\\n--- Checking Candidate: \>\"", ",", 
              RowBox[{"Flatten", "[", 
               RowBox[{"List", "@@", "candidate"}], "]"}]}], "]"}], ",", 
            RowBox[{"(*", 
             RowBox[{
             "Substitute", " ", "the", " ", "candidate", " ", "solution", " ",
               "into", " ", "the", " ", "Hessians"}], "*)"}], 
            RowBox[{"hA", "=", 
             RowBox[{"hessianA", "/.", " ", "currentCandidateRules"}]}], ",", 
            RowBox[{"hB", "=", 
             RowBox[{"hessianB", "/.", " ", "currentCandidateRules"}]}], ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
              "Check", " ", "if", " ", "the", " ", "Hessians", " ", "are", 
               " ", "negative", " ", "semi"}], "-", 
              RowBox[{"definite", "."}]}], "*)"}], 
            RowBox[{"(*", 
             RowBox[{
             "This", " ", "is", " ", "true", " ", "if", " ", "all", " ", 
              "their", " ", "eigenvalues", " ", "are", " ", "less", " ", 
              "than", " ", "or", " ", "equal", " ", "to", " ", 
              RowBox[{"zero", "."}]}], "*)"}], 
            RowBox[{"isMaxA", "=", 
             RowBox[{"AllTrue", "[", 
              RowBox[{
               RowBox[{"Eigenvalues", "[", "hA", "]"}], ",", 
               RowBox[{
                RowBox[{"#", "<=", "0"}], "&"}]}], "]"}]}], ",", 
            RowBox[{"isMaxB", "=", 
             RowBox[{"AllTrue", "[", 
              RowBox[{
               RowBox[{"Eigenvalues", "[", "hB", "]"}], ",", 
               RowBox[{
                RowBox[{"#", "<=", "0"}], "&"}]}], "]"}]}], ",", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Player A's Hessian eigenvalues: \>\"", ",", 
              RowBox[{"Eigenvalues", "[", "hA", "]"}], ",", 
              "\"\< -> Is Maximum? \>\"", ",", "isMaxA"}], "]"}], ",", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Player B's Hessian eigenvalues: \>\"", ",", 
              RowBox[{"Eigenvalues", "[", "hB", "]"}], ",", 
              "\"\< -> Is Maximum? \>\"", ",", "isMaxB"}], "]"}], ",", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
              "If", " ", "both", " ", "conditions", " ", "are", " ", "met"}], 
              ",", 
              RowBox[{
               RowBox[{"it", "'"}], "s", " ", "a", " ", "Nash", " ", 
               "Equilibrium"}]}], "*)"}], 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"isMaxA", "&&", "isMaxB"}], ",", 
              RowBox[{
              "Print", "[", "\"\<==> Candidate is a Nash Equilibrium.\>\"", 
               "]"}], ",", 
              RowBox[{"AppendTo", "[", 
               RowBox[{"equilibria", ",", "currentCandidateRules"}], "]"}]}], 
             "]"}]}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"candidate", ",", "candidates"}], "}"}]}], "]"}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
        "Print", "[", 
         "\"\<\\n----------------------------------------------------\>\"", 
         "]"}], ";", "\[IndentingNewLine]", 
        RowBox[{"Return", "[", "equilibria", "]"}], ";"}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "Example"}]}], " ", 
      RowBox[{"Usage", "--"}]}], "-"}], "*)"}], "\n", "\[IndentingNewLine]", 
   RowBox[{"(*", 

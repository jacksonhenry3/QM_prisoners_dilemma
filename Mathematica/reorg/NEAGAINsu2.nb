Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Player B's score function: bscore(a,b) = \"\>", 
   "\[InvisibleSpace]", 
   RowBox[{
    RowBox[{
     SqrtBox["2"], " ", 
     RowBox[{"Cos", "[", "\[Theta]1", "]"}], " ", 
     RowBox[{"Cos", "[", "\[Theta]2", "]"}], " ", 
     RowBox[{"Sin", "[", "\[Theta]1", "]"}], " ", 
     RowBox[{"Sin", "[", "\[Theta]2", "]"}], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        RowBox[{"-", "3"}], " ", 
        RowBox[{"Cos", "[", "\[Phi]2", "]"}], " ", 
        RowBox[{"Sin", "[", "\[Phi]1", "]"}]}], "+", 
       RowBox[{"2", " ", 
        RowBox[{"Cos", "[", "\[Phi]1", "]"}], " ", 
        RowBox[{"Sin", "[", "\[Phi]2", "]"}]}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Cos", "[", "\[Theta]1", "]"}], "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Theta]2", "]"}], "2"]}], "+", 
       RowBox[{
        FractionBox["5", "2"], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]2", "]"}], "2"], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Phi]2", "]"}], "2"]}]}], ")"}]}], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Sin", "[", "\[Theta]1", "]"}], "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"5", " ", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Theta]2", "]"}], "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Phi]1", "]"}], "2"], "+", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"Sin", "[", "\[Phi]1", "]"}], "2"], "2"]}], ")"}]}], "+", 
       RowBox[{
        FractionBox["1", "4"], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]2", "]"}], "2"], " ", 
        RowBox[{"(", 
         RowBox[{"6", "-", 
          RowBox[{"2", " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"2", " ", 
             RowBox[{"(", 
              RowBox[{"\[Phi]1", "+", "\[Phi]2"}], ")"}]}], "]"}]}], "+", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              FractionBox["\[Pi]", "4"], "+", "\[Phi]1", "+", "\[Phi]2"}], 
             ")"}]}], "]"}], "+", 
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{"2", " ", "\[Phi]1"}], "+", 
            RowBox[{"2", " ", "\[Phi]2"}]}], "]"}]}], ")"}]}]}], ")"}]}]}]}],
  SequenceForm[
  "Player B's score function: bscore(a,b) = ", 
   2^Rational[1, 2] Cos[$CellContext`\[Theta]1] Cos[$CellContext`\[Theta]2] 
    Sin[$CellContext`\[Theta]1] 
    Sin[$CellContext`\[Theta]2] ((-3) Cos[$CellContext`\[Phi]2] 
      Sin[$CellContext`\[Phi]1] + 
     2 Cos[$CellContext`\[Phi]1] Sin[$CellContext`\[Phi]2]) + 
   Cos[$CellContext`\[Theta]1]^2 (3 Cos[$CellContext`\[Theta]2]^2 + 
     Rational[5, 2] Sin[$CellContext`\[Theta]2]^2 
      Sin[$CellContext`\[Phi]2]^2) + 
   Sin[$CellContext`\[Theta]1]^2 (
     5 Cos[$CellContext`\[Theta]2]^2 (Cos[$CellContext`\[Phi]1]^2 + 
       Rational[1, 2] Sin[$CellContext`\[Phi]1]^2) + 
     Rational[1, 4] 
      Sin[$CellContext`\[Theta]2]^2 (6 - 2 
       Cos[2 ($CellContext`\[Phi]1 + $CellContext`\[Phi]2)] + 
       Cos[2 (Rational[1, 4] 
           Pi + $CellContext`\[Phi]1 + $CellContext`\[Phi]2)] + 
       Sin[2 $CellContext`\[Phi]1 + 2 $CellContext`\[Phi]2]))],
  Editable->False]], "Print",

Cell[BoxData[
 InterpretationBox[
  RowBox[{"\<\"Player A's score function: ascore(a,b) = \"\>", 
   "\[InvisibleSpace]", 
   RowBox[{
    FractionBox[
     RowBox[{
      RowBox[{"Cos", "[", "\[Theta]1", "]"}], " ", 
      RowBox[{"Sin", "[", "\[Theta]1", "]"}], " ", 
      RowBox[{"Sin", "[", 
       RowBox[{"2", " ", "\[Theta]2"}], "]"}], " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"2", " ", 
         RowBox[{"Cos", "[", "\[Phi]2", "]"}], " ", 
         RowBox[{"Sin", "[", "\[Phi]1", "]"}]}], "-", 
        RowBox[{"3", " ", 
         RowBox[{"Cos", "[", "\[Phi]1", "]"}], " ", 
         RowBox[{"Sin", "[", "\[Phi]2", "]"}]}]}], ")"}]}], 
     SqrtBox["2"]], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Cos", "[", "\[Theta]1", "]"}], "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{"3", " ", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Theta]2", "]"}], "2"]}], "+", 
       RowBox[{"5", " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]2", "]"}], "2"], " ", 
        RowBox[{"(", 
         RowBox[{
          SuperscriptBox[
           RowBox[{"Cos", "[", "\[Phi]2", "]"}], "2"], "+", 
          FractionBox[
           SuperscriptBox[
            RowBox[{"Sin", "[", "\[Phi]2", "]"}], "2"], "2"]}], ")"}]}]}], 
      ")"}]}], "+", 
    RowBox[{
     SuperscriptBox[
      RowBox[{"Sin", "[", "\[Theta]1", "]"}], "2"], " ", 
     RowBox[{"(", 
      RowBox[{
       RowBox[{
        FractionBox["5", "2"], " ", 
        SuperscriptBox[
         RowBox[{"Cos", "[", "\[Theta]2", "]"}], "2"], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Phi]1", "]"}], "2"]}], "+", 
       RowBox[{
        FractionBox["1", "4"], " ", 
        SuperscriptBox[
         RowBox[{"Sin", "[", "\[Theta]2", "]"}], "2"], " ", 
        RowBox[{"(", 
         RowBox[{"6", "-", 
          RowBox[{"2", " ", 
           RowBox[{"Cos", "[", 
            RowBox[{"2", " ", 
             RowBox[{"(", 
              RowBox[{"\[Phi]1", "+", "\[Phi]2"}], ")"}]}], "]"}]}], "+", 
          RowBox[{"Cos", "[", 
           RowBox[{"2", " ", 
            RowBox[{"(", 
             RowBox[{
              FractionBox["\[Pi]", "4"], "+", "\[Phi]1", "+", "\[Phi]2"}], 
             ")"}]}], "]"}], "+", 
          RowBox[{"Sin", "[", 
           RowBox[{
            RowBox[{"2", " ", "\[Phi]1"}], "+", 
            RowBox[{"2", " ", "\[Phi]2"}]}], "]"}]}], ")"}]}]}], ")"}]}]}]}],
  SequenceForm[
  "Player A's score function: ascore(a,b) = ", 
   2^Rational[-1, 2] Cos[$CellContext`\[Theta]1] Sin[$CellContext`\[Theta]1] 
    Sin[2 $CellContext`\[Theta]2] (
     2 Cos[$CellContext`\[Phi]2] Sin[$CellContext`\[Phi]1] - 3 
     Cos[$CellContext`\[Phi]1] Sin[$CellContext`\[Phi]2]) + 
   Cos[$CellContext`\[Theta]1]^2 (3 Cos[$CellContext`\[Theta]2]^2 + 
     5 Sin[$CellContext`\[Theta]2]^2 (Cos[$CellContext`\[Phi]2]^2 + 
       Rational[1, 2] Sin[$CellContext`\[Phi]2]^2)) + 
   Sin[$CellContext`\[Theta]1]^2 (
     Rational[5, 2] Cos[$CellContext`\[Theta]2]^2 Sin[$CellContext`\[Phi]1]^2 + 
     Rational[1, 4] 
      Sin[$CellContext`\[Theta]2]^2 (6 - 2 
       Cos[2 ($CellContext`\[Phi]1 + $CellContext`\[Phi]2)] + 
       Cos[2 (Rational[1, 4] 
           Pi + $CellContext`\[Phi]1 + $CellContext`\[Phi]2)] + 

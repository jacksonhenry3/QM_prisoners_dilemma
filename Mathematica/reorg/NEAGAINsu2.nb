       RowBox[{"\[Theta]2", "->", 
        RowBox[{"bmove", "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ",", 
       RowBox[{"\[Phi]2", "->", " ", 
        RowBox[{"bmove", "[", 

   RowBox[{
    RowBox[{"amove", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\[Theta]1", ",", "\[Phi]1"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"bmove", " ", "=", " ", 
     RowBox[{"{", 
      RowBox[{"\[Theta]2", ",", "\[Phi]2"}], "}"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Define", " ", "the", " ", "score", " ", 
      RowBox[{"functions", ".", "In"}], " ", "this", " ", "example"}], ",", 
     RowBox[{

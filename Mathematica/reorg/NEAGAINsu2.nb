Cell[BoxData[
 RowBox[{"\[IndentingNewLine]", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"visualizeInteractiveGame", "[", 
      RowBox[{"ascoreFunc_", ",", "bscoreFunc_"}], "]"}], ":=", 
     RowBox[{"Manipulate", "[", 
      RowBox[{"(*", 
       RowBox[{
       "The", " ", "body", " ", "of", " ", "the", " ", "Manipulate", " ", 
        "will", " ", "be", " ", "a", " ", "Grid", " ", "containing", " ", 
        "our", " ", "two", " ", "plots"}], "*)"}], 
      RowBox[{
       RowBox[{"Grid", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"(*", 
           RowBox[{"Header", " ", "Row"}], "*)"}], 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Style", "[", 
              RowBox[{
              "\"\<Player A's Score & Move\>\"", ",", "14", ",", "Bold"}], 
              "]"}], ",", 
             RowBox[{"Style", "[", 
              RowBox[{
              "\"\<Player B's Score & Move\>\"", ",", "14", ",", "Bold"}], 
              "]"}]}], "}"}], ",", 
           RowBox[{"(*", 
            RowBox[{"Main", " ", "Content", " ", "Row"}], "*)"}], 
           RowBox[{"{", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"Panel", " ", "1"}], ":", 
              RowBox[{"Player", " ", 
               RowBox[{"A", "'"}], "s", " ", "score", " ", "landscape"}]}], 
             "*)"}], 
            RowBox[{
             RowBox[{"Show", "[", 
              RowBox[{
               RowBox[{"DensityPlot", "[", 
                RowBox[{
                 RowBox[{"ascoreFunc", "[", 
                  RowBox[{
                   RowBox[{"{", 
                    RowBox[{"ax", ",", "ay"}], "}"}], ",", "bMovePoint"}], 
                  "]"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"ax", ",", "0", ",", "Pi"}], "}"}], ",", 
                 RowBox[{"{", 
                  RowBox[{"ay", ",", "0", ",", " ", "Pi"}], "}"}], ",", 
                 RowBox[{"FrameLabel", "->", 
                  RowBox[{"{", 
                   RowBox[{"\"\<ax\>\"", ",", "\"\<ay\>\""}], "}"}]}], ",", 
                 RowBox[{
                 "PlotLabel", "->", "\"\<A's score given B's move\>\""}], ",", 
                 RowBox[{"ImageSize", "->", "Medium"}], ",", 
                 RowBox[{"AspectRatio", "->", "1"}], ",", 
                 RowBox[{"PlotLegends", "->", "Automatic"}], ",", 
                 RowBox[{"ColorFunction", "->", "\"\<TemperatureMap\>\""}], 
                 ",", 
                 RowBox[{"PlotRange", "->", 
                  RowBox[{"{", 
                   RowBox[{"0", ",", "5"}], "}"}]}]}], "]"}], ",", 
               RowBox[{"(*", 
                RowBox[{
                "Graphics", " ", "overlay", " ", "to", " ", "show", " ", 

               RowBox[{"sA", ",", "sB", ",", "game"}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"currentScoreB", "=", 
              RowBox[{"bscore", "[", 
               RowBox[{"sA", ",", "sB", ",", "game"}], "]"}]}], ";", 

       RowBox[{"(*", 
        RowBox[{
        "Iterate", " ", "over", " ", "every", " ", "possible", " ", 
         "strategy", " ", "for", " ", "player", " ", "A"}], "*)"}], 
       RowBox[{
        RowBox[{"Do", "[", 
         RowBox[{"(*", 
          RowBox[{

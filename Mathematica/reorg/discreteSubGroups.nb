  3.9556532202285976`*^9}},ExpressionUUID->"5294783d-4684-0d44-8207-\
f2f54c8d71a5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"--", 
      RowBox[{"-", "single"}]}], " ", "element", " ", "of", " ", "the", " ", 
     "binary", " ", "dihedral", " ", "group", " ", 
     RowBox[{"Dic_n", "--"}]}], "-"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"binaryDihedral", "[", 
      RowBox[{"k_", ",", "x_", ",", "n_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"A", ",", "B"}], "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{"A", "=", 
          RowBox[{"rotation", " ", "by", " ", 
           RowBox[{"\[Pi]", "/", "n"}], " ", "about", " ", 
           RowBox[{"z", ":", 
            RowBox[{"order", " ", "2", "n"}]}]}]}], ",", 
         RowBox[{
          RowBox[{"with", " ", 
           RowBox[{"A", "^", "n"}]}], "=", 
          RowBox[{"-", "I"}]}]}], "*)"}], 
       RowBox[{
        RowBox[{"A", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Exp", "[", 
              RowBox[{"I", "*", 
               RowBox[{"\[Pi]", "/", "n"}]}], "]"}], ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"Exp", "[", 
              RowBox[{
               RowBox[{"-", "I"}], "*", 
               RowBox[{"\[Pi]", "/", "n"}]}], "]"}]}], "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"(*", 
         RowBox[{"B", "=", 
          RowBox[{
           RowBox[{
           "lift", " ", "of", " ", "the", " ", "180", "\[Degree]", " ", 
            "flip", " ", "about", " ", 
            RowBox[{"x", ":", 
             RowBox[{"B", "^", "2"}]}]}], "=", 
           RowBox[{
            RowBox[{"-", "I"}], "=", 
            RowBox[{"A", "^", "n"}]}]}]}], "*)"}], 
        RowBox[{"B", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "I"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"I", ",", "0"}], "}"}]}], "}"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"MatrixPower", "[", 
          RowBox[{"A", ",", "k"}], "]"}], ".", 
         RowBox[{"MatrixPower", "[", 
          RowBox[{"B", ",", "x"}], "]"}]}]}]}], "]"}]}], ";"}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
      RowBox[{"--", 
       RowBox[{"-", "assemble"}]}], " ", "all", " ", "4", "n", " ", 
      "elements", " ", "and", " ", "drop", " ", 
      RowBox[{"duplicates", "--"}]}], "-"}], "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{
     RowBox[{"binaryDihedralGroup", "[", "n_", "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "elems", "}"}], ",", 
       RowBox[{
        RowBox[{"elems", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"binaryDihedral", "[", 
              RowBox[{"k", ",", "x", ",", "n"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"k", ",", "0", ",", 
               RowBox[{
                RowBox[{"2", " ", "n"}], "-", "1"}]}], "}"}], ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"A", "^", "0"}], " ", "\[Ellipsis]", " ", 
               RowBox[{"A", "^", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"2", "n"}], "\[Minus]", "1"}], ")"}]}]}], "*)"}], 
             RowBox[{"{", 
              RowBox[{"x", ",", "0", ",", "1"}], "}"}]}], "         ", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{"identity", " ", "or", " ", "one", " ", "B"}], "-", 
              "flip"}], "*)"}], "]"}], ",", "1"}], "]"}]}], ";", 
        "\[IndentingNewLine]", 
        RowBox[{"DeleteDuplicates", "[", "elems", "]"}]}]}], "]"}]}], ";"}], 
   "\n"}]}]], "Input",
 CellChangeTimes->{{3.955647043886717*^9, 3.9556471101132565`*^9}, 
   3.9556472259895725`*^9, {3.955647381450199*^9, 3.955647450388199*^9}, {
   3.955647496041078*^9, 3.955647496126226*^9}, {3.955647538804123*^9, 

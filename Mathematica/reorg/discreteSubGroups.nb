Cell[CellGroupData[{

Cell["binary octahedral (incorrect becouse you need srs)", "Subsubsection",
 CellChangeTimes->{{3.955646567551914*^9, 3.9556465974078403`*^9}, {
  3.9594144356716022`*^9, 
  3.9594144456763496`*^9}},ExpressionUUID->"dfe0ff31-dfb0-1740-aae9-\
4f90ee98cc63"],

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
     RowBox[{"single", " ", "binary"}], "-", 
     RowBox[{
     "octahedral", " ", "element", " ", "from", " ", "exponents", " ", 
      "i"}]}], ",", "j"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"binaryOctahedral", "[", 
      RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"\[Omega]8", "=", 
          RowBox[{"Exp", "[", 
           RowBox[{"I", "*", 
            RowBox[{"\[Pi]", "/", "4"}]}], "]"}]}], ",", 
         RowBox[{"(*", 
          RowBox[{"e", "^", 
           RowBox[{"{", 
            RowBox[{"i\[Pi]", "/", "4"}], "}"}]}], "*)"}], "r", ",", "s"}], 
        "}"}], ",", 
       RowBox[{
        RowBox[{"r", "=", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"\[Omega]8", ",", "0"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"Conjugate", "[", "\[Omega]8", "]"}]}], "}"}]}], "}"}]}],
         ";", 
        RowBox[{"(*", 
         RowBox[{"order", " ", "8"}], "*)"}], 
        RowBox[{"s", "=", 
         RowBox[{
          RowBox[{"1", "/", "2"}], " ", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{
              RowBox[{"1", "+", "I"}], ",", 
              RowBox[{"1", "+", "I"}]}], "}"}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"I", "-", "1"}], ",", 
              RowBox[{"1", "-", "I"}]}], "}"}]}], "}"}]}]}], ";", 
        RowBox[{"(*", 
         RowBox[{"order", " ", "6"}], "*)"}], 
        RowBox[{
         RowBox[{"MatrixPower", "[", 
          RowBox[{"r", ",", "i"}], "]"}], ".", 
         RowBox[{"MatrixPower", "[", 
          RowBox[{"s", ",", "j"}], "]"}]}]}]}], "]"}]}], ";"}], "\n", 
   "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
    "the", " ", "full", " ", "group", " ", "of", " ", "48", " ", "elements"}],
     "*)"}], "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"binaryOctahedralGroup", "=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", "elems", "}"}], ",", 
       RowBox[{
        RowBox[{"elems", "=", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"binaryOctahedral", "[", 
              RowBox[{"i", ",", "j"}], "]"}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "0", ",", "7"}], "}"}], ",", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{"r", "^", "8"}], "=", "I"}], "*)"}], 

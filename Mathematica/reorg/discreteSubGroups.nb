Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"cyclic", "[", 
    RowBox[{"k_", ",", "n_"}], "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"2", "\[Pi]", " ", 
         FractionBox["k", "n"]}], "]"}], ",", 
       RowBox[{"-", 
        RowBox[{"Sin", "[", 
         RowBox[{"2", "\[Pi]", " ", 
          FractionBox["k", "n"]}], "]"}]}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"2", "\[Pi]", " ", 
         FractionBox["k", "n"]}], "]"}], ",", 
       RowBox[{"Cos", "[", 
        RowBox[{"2", "\[Pi]", " ", 
         FractionBox["k", "n"]}], "]"}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"cyclicGroup", "[", "n_", "]"}], " ", "/;", 
   RowBox[{"n", ">", "2"}]}], ":=", 
  RowBox[{"Table", "[", 
   RowBox[{
    RowBox[{"cyclic", "[", 
     RowBox[{"k", ",", "n"}], "]"}], ",", 
    RowBox[{"{", 
     RowBox[{"k", ",", "0", ",", "n"}], "}"}]}], "]"}]}]}], "Input",

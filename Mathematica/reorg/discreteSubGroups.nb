Cell[BoxData[
 RowBox[{
  RowBox[{"$Assumptions", "=", 
   RowBox[{
    RowBox[{"Element", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "a", ",", "b", ",", "\[Theta]", ",", "\[Phi]", ",", "\[Psi]", ",", 
        "\[Theta]1", ",", "\[Phi]1", ",", "\[Psi]1", ",", "\[Theta]2", ",", 
        "\[Phi]2", ",", "\[Psi]2", ",", "x1", ",", "y1", ",", "z1", ",", "x2",
         ",", "y2", ",", "z2", ",", "i", ",", "j", ",", "k", ",", "l", ",", 
        "n"}], "}"}], ",", "Reals"}], "]"}], "&&", 
    RowBox[{"0", "<", "\[Gamma]", "<", 
     RowBox[{"Pi", "/", "2"}]}], "&&", 
    RowBox[{"Element", "[", 
     RowBox[{"\[Gamma]", ",", "Reals"}], "]"}]}]}], ";"}]], "Input",
 CellChangeTimes->{{3.955653027868162*^9, 3.9556530307563*^9}},
 CellLabel->"In[64]:=",ExpressionUUID->"32cb6dfb-001f-0f41-9608-2a59faf85eaf"],

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"ScaledAntiHermitianMatrix", "[", "a_", "]"}], ":=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"I", " ", "a"}], ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", 
       RowBox[{"I", " ", "a"}]}], "}"}]}], "}"}]}], 
  ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"JtrigForm", "[", 
    RowBox[{"a_", ",", "b_", ",", "\[Gamma]_"}], "]"}], " ", "=", 
   RowBox[{
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"MatrixExp", "[", 
        RowBox[{
         RowBox[{"-", "I"}], " ", 
         FractionBox["\[Gamma]", "2"], " ", 
         RowBox[{"KroneckerProduct", "[", 
          RowBox[{
           RowBox[{"ScaledAntiHermitianMatrix", "[", "a", "]"}], ",", 
           RowBox[{"ScaledAntiHermitianMatrix", "[", "b", "]"}]}], "]"}]}], 
        "]"}], "//", "TrigToExp"}], ")"}], "//", "ExpToTrig"}], "//", 
    "FullSimplify"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{
   RowBox[{"J", "[", 
    RowBox[{"a_", ",", "b_", ",", "\[Gamma]_"}], "]"}], " ", "=", 
   RowBox[{
    RowBox[{"(", 
     RowBox[{
      RowBox[{"(", 
       FractionBox["1", 
        RowBox[{
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           FractionBox["1", "2"], " ", "\[ImaginaryI]", " ", "a", " ", "b", 
           " ", "\[Gamma]"}]], 
         SuperscriptBox["\[ExponentialE]", 
          RowBox[{
           RowBox[{"-", 
            FractionBox["1", "2"]}], " ", "\[ImaginaryI]", " ", 
           RowBox[{"(", 
            RowBox[{"1", "+", "a", "+", "b"}], ")"}], " ", "\[Gamma]"}]]}]], 
       ")"}], 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"MatrixExp", "[", 
         RowBox[{
          RowBox[{"-", "I"}], " ", 
          FractionBox["\[Gamma]", "2"], " ", 
          RowBox[{"KroneckerProduct", "[", 
           RowBox[{
            RowBox[{"ScaledAntiHermitianMatrix", "[", "a", "]"}], ",", 
            RowBox[{"ScaledAntiHermitianMatrix", "[", "b", "]"}]}], "]"}]}], 
         "]"}], "//", "TrigToExp"}], ")"}]}], ")"}], "//", "FullSimplify"}]}],
   ";"}]}], "Input",
 CellChangeTimes->{{3.9556458840210457`*^9, 3.955645891098512*^9}, {
  3.955646523318416*^9, 3.955646524106676*^9}},

Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"binaryTetrahedral", "[", 
    RowBox[{"i_", ",", "j_"}], "]"}], ":=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"\[Omega]1", "=", 
        RowBox[{"Exp", "[", 
         RowBox[{"2", " ", "Pi", " ", 
          RowBox[{"I", "/", "6"}]}], "]"}]}], ",", 
       RowBox[{"\[Omega]2", "=", 
        RowBox[{"Exp", "[", 
         RowBox[{"Pi", " ", 
          RowBox[{"I", "/", "2"}]}], "]"}]}], ",", "A", ",", "B"}], "}"}], 
     ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"A", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\[Omega]1", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"0", ",", 
           RowBox[{"Conjugate", "[", "\[Omega]1", "]"}]}], "}"}]}], "}"}]}], 
      ";", "\[IndentingNewLine]", 
      RowBox[{"B", "=", 
       RowBox[{
        RowBox[{"(", 
         RowBox[{"1", "/", 
          RowBox[{"Sqrt", "[", "2", "]"}]}], ")"}], " ", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"\[Omega]2", ",", "\[Omega]2"}], "}"}], ",", 
          RowBox[{"{", 
           RowBox[{"\[Omega]2", ",", 
            RowBox[{"-", "\[Omega]2"}]}], "}"}]}], "}"}]}]}], ";", 
      "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{"MatrixPower", "[", 
        RowBox[{"A", ",", "i"}], "]"}], ".", 
       RowBox[{"MatrixPower", "[", 
        RowBox[{"B", ",", "j"}], "]"}]}]}]}], "]"}]}], 
  "\[IndentingNewLine]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "generate", " ", "the", " ", "full", " ", 
    "group"}], "*)"}], 
  RowBox[{
   RowBox[{"binaryTetrahedralGroup", "=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", "elements", "}"}], ",", 
      RowBox[{
       RowBox[{"elements", "=", 
        RowBox[{"Flatten", "[", 
         RowBox[{
          RowBox[{"Table", "[", 
           RowBox[{
            RowBox[{"binaryTetrahedral", "[", 
             RowBox[{"i", ",", "j"}], "]"}], ",", 
            RowBox[{"{", 
             RowBox[{"i", ",", "0", ",", "5"}], "}"}], ",", 
            RowBox[{"(*", 
             RowBox[{"A", " ", "has", " ", "order", " ", "6"}], "*)"}], 
            RowBox[{"{", 
             RowBox[{"j", ",", "0", ",", "3"}], "}"}]}], "   ", 
           RowBox[{"(*", 
            RowBox[{"B", " ", "has", " ", "order", " ", "4"}], "*)"}], "]"}], 
          ",", "1"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"DeleteDuplicates", "[", "elements", "]"}]}]}], "]"}]}], 
   ";"}]}]}], "Input",
 CellChangeTimes->{{3.955647599974188*^9, 3.9556476233183775`*^9}, {
   3.955647663570982*^9, 3.955647764909675*^9}, 3.9556480561224957`*^9, {

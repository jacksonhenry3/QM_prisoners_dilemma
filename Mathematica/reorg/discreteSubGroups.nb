Cell[CellGroupData[{

Cell["su2", "Subsubsection",
 CellChangeTimes->{{3.955646567551914*^9, 
  3.955646567968487*^9}},ExpressionUUID->"96ddad80-ef48-9848-8b4f-\
27c61f69f0a8"],

Cell["\<\
An arbitrary element of su2, where \[Theta] and \[Phi] define a unit vector, \
and \[Zeta] a rotation around that unit vector.\
\>", "Text",
 CellChangeTimes->{{3.95564668890934*^9, 
  3.955646734628847*^9}},ExpressionUUID->"a61f6f9b-09e0-0042-8508-\
18a41354f3e8"],

Cell[BoxData[
 RowBox[{
  RowBox[{"su2", "[", 
   RowBox[{"\[Theta]_", ",", "\[Phi]_", ",", "\[Zeta]_"}], "]"}], ":=", 
  RowBox[{"{", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"\[Zeta]", "/", "2"}], "]"}], "-", 
       RowBox[{"I", "*", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Zeta]", "/", "2"}], "]"}]}]}], ",", 
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"\[Zeta]", "/", "2"}], "]"}], "*", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "I"}], ")"}], "*", 
          RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "-", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ")"}]}]}], "}"}], ",", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Sin", "[", 
        RowBox[{"\[Zeta]", "/", "2"}], "]"}], "*", 
       RowBox[{"Sin", "[", "\[Theta]", "]"}], "*", 
       RowBox[{"(", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{"-", "I"}], ")"}], "*", 
          RowBox[{"Cos", "[", "\[Phi]", "]"}]}], "+", 
         RowBox[{"Sin", "[", "\[Phi]", "]"}]}], ")"}]}], ",", 
      RowBox[{
       RowBox[{"Cos", "[", 
        RowBox[{"\[Zeta]", "/", "2"}], "]"}], "+", 
       RowBox[{"I", "*", 
        RowBox[{"Cos", "[", "\[Theta]", "]"}], "*", 
        RowBox[{"Sin", "[", 
         RowBox[{"\[Zeta]", "/", "2"}], "]"}]}]}]}], "}"}]}], 
   "}"}]}]], "Input",
 CellChangeTimes->{{3.955646682829799*^9, 3.9556466840008774`*^9}},
 CellLabel->"In[68]:=",ExpressionUUID->"983ed430-f4b4-e649-b9b8-43327419f98c"]
}, Closed]],


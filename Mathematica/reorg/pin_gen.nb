Cell[BoxData[{
 RowBox[{
  RowBox[{"g", " ", "=", " ", "\[Gamma]"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"aa", " ", "=", " ", "a"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"i", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"j", "=", "2"}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"candidates", "=", 
   RowBox[{
    RowBox[{"FindCriticalPoints", "[", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{
       RowBox[{"ascore", "[", 
        RowBox[{
         RowBox[{"{", "\[Theta]1", "}"}], ",", 
         RowBox[{"{", "\[Theta]2", "}"}], ",", 
         RowBox[{"{", 

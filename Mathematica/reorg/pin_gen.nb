Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"avars", " ", "=", " ", 
   RowBox[{"{", "\[Theta]1", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"bvars", " ", "=", " ", 
   RowBox[{"{", "\[Theta]2", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Assumes", " ", "aScoresComputed", " ", "and", " ", "bScoresComputed", " ",
     "are", " ", "2", "x2", " ", "matrices", " ", "of", " ", "your", " ", 
    "payoff", " ", "expressions"}], "*)"}], 
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Also", " ", "assumes", " ", "avars", " ", "and", " ", "bvars", " ", 
     "are", " ", "defined"}], ",", 
    RowBox[{"e", ".", "g", "."}], ",", 
    RowBox[{
     RowBox[{"avars", "=", 
      RowBox[{"{", "\[Theta]1", "}"}]}], ";", 
     RowBox[{"bvars", "=", 
      RowBox[{"{", "\[Theta]2", "}"}]}], ";"}]}], "*)"}], 
  RowBox[{
   RowBox[{"conditionalEquilibria", "=", 
    RowBox[{
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
          "ascore", ",", "bscore", ",", "criticalPoints", ",", 
           "nashEquilibria"}], "}"}], ",", 
         RowBox[{"(*", 
          RowBox[{
          "1.", " ", "Define", " ", "the", " ", "payoff", " ", "for", " ", 
           "the", " ", "subgame", " ", 
           RowBox[{"{", 
            RowBox[{"i", ",", "j"}], "}"}]}], "*)"}], 
         RowBox[{
          RowBox[{"ascore", "=", 
           RowBox[{"aScore0Simp", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"bscore", "=", 
           RowBox[{"bScore0Simp", "[", 
            RowBox[{"[", 
             RowBox[{"i", ",", "j"}], "]"}], "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "2.", " ", "Find", " ", "critical", " ", "points", " ", "for", " ",
             "the", " ", "continuous", " ", "variables", " ", "in", " ", 
            "this", " ", "subgame"}], "*)"}], "\[IndentingNewLine]", 
          RowBox[{"criticalPoints", "=", 
           RowBox[{
            RowBox[{"FindCriticalPoints", "[", 
             RowBox[{"ascore", ",", "bscore", ",", "avars", ",", "bvars"}], 
             "]"}], "//", "FullSimplify"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"criticalPoints", " ", "=", " ", 
           RowBox[{"FullSimplify", "[", "criticalPoints", "]"}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", "criticalPoints", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"Print", "[", "\"\<filtering to maxima\>\"", "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{
           "3.", " ", "Verify", " ", "which", " ", "are", " ", "Nash", " ", 
            "Equilibria", " ", "for", " ", "the", " ", "subgame"}], "*)"}], 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"criticalPoints", "=!=", 
              RowBox[{"{", "}"}]}], "&&", 
             RowBox[{"criticalPoints", "=!=", "$Failed"}]}], ",", 
            RowBox[{
             RowBox[{"nashEquilibria", "=", 
              RowBox[{"VerifyNashEquilibria", "[", 
               RowBox[{"ascore", ",", "bscore", ",", 
                RowBox[{"{", "\[Theta]1", "}"}], ",", 
                RowBox[{"{", "\[Theta]2", "}"}], ",", "criticalPoints"}], 
               "]"}]}], ";", "\[IndentingNewLine]", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"i", ",", "j"}], "}"}], ",", "nashEquilibria"}], 
              "}"}]}], ",", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"i", ",", "j"}], "}"}], ",", 
              RowBox[{"{", "}"}]}], "}"}]}], " ", 
           RowBox[{"(*", 
            RowBox[{
            "No", " ", "solutions", " ", "found", " ", "for", " ", "this", 
             " ", "subgame"}], "*)"}], "]"}]}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"i", ",", "1", ",", "2"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"j", ",", "1", ",", "2"}], "}"}]}], "]"}], "//", 
     RowBox[{
      RowBox[{"Flatten", "[", 
       RowBox[{"#", ",", "1"}], "]"}], "&"}]}]}], ";"}], "\n", 
  "\[IndentingNewLine]", 
  RowBox[{"(*", 
   RowBox[{"This", " ", "gives", " ", "a", " ", "list", " ", "of", " ", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"discrete_i", ",", "discrete_j"}], "}"}], ",", 
      RowBox[{"{", 
       RowBox[{"list", " ", "of", " ", "equilibria"}], "}"}]}], "}"}]}], 
   "*)"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Print", "[", 
   RowBox[{
   "\"\<Conditional Equilibria Found: \>\"", ",", "conditionalEquilibria"}], 
   "]"}], ";"}]}], "Input",

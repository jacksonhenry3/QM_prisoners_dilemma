Cell[BoxData[
 RowBox[{
  RowBox[{"ReduceToRules", "[", 
   RowBox[{"expression_", ",", "vars_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", "reduceOutput", "}"}], ",", 
    RowBox[{"(*", 
     RowBox[{"First", ",", 
      RowBox[{
      "get", " ", "the", " ", "logical", " ", "expression", " ", "from", " ", 
       "Reduce"}]}], "*)"}], 
    RowBox[{
     RowBox[{"reduceOutput", "=", 
      RowBox[{"Reduce", "[", 
       RowBox[{"expression", ",", "vars"}], "]"}]}], ";", 
     "\[IndentingNewLine]", 
     RowBox[{"(*", 
      RowBox[{
       RowBox[{"If", " ", "Reduce", " ", "returns", " ", "False", " ", 
        RowBox[{"(", 
         RowBox[{"no", " ", "solution"}], ")"}]}], ",", 
       RowBox[{"return", " ", "an", " ", "empty", " ", 
        RowBox[{"list", ".", "Otherwise"}]}], ",", 
       RowBox[{
       "use", " ", "Solve", " ", "to", " ", "convert", " ", "the", " ", 
        "expression", " ", "to", " ", 
        RowBox[{"rules", "."}]}]}], "*)"}], 
     RowBox[{"If", "[", 
      RowBox[{
       RowBox[{"reduceOutput", "===", "False"}], ",", 
       RowBox[{"{", "}"}], ",", 
       RowBox[{"Solve", "[", 
        RowBox[{"reduceOutput", ",", "vars"}], "]"}]}], "]"}]}]}], 
   "]"}]}]], "Input",

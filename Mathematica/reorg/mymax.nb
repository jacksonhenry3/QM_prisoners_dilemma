    RowBox[{"MyMax", "[", 
     RowBox[{"expression", ",", "variable"}], "]"}], " ", "Finds", " ", "a", 
    " ", "logical", " ", "expression", " ", "describing", " ", "all", " ", 
    "values", " ", 
    RowBox[{"of", "'"}], 

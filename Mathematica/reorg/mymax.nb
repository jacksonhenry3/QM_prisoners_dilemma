    RowBox[{"the", "'"}], 
    RowBox[{
     RowBox[{"expression", "'"}], ".", "This"}], " ", "version", " ", "uses", 
    " ", "a", " ", "more", " ", "robust", " ", "method", " ", "by", " ", 
    "asking", " ", "Reduce", " ", "to", " ", "solve", " ", "for", " ", "both",
     " ", "conditions", " ", "of", " ", "a", " ", "maximum", " ", 
    RowBox[{"(", 
     RowBox[{
      RowBox[{
       RowBox[{"f", "'"}], "[", "x", "]"}], "==", 
      RowBox[{"0", " ", "and", " ", 
       RowBox[{
        RowBox[{"f", "''"}], "[", "x", "]"}]}], "<", "0"}], ")"}], " ", 
    RowBox[{"simultaneously", ".", 
     RowBox[{"Parameters", ":", 
      RowBox[{"-", "expr"}], ":", 
      RowBox[{"The", " ", "mathematical", " ", "expression", " ", "to", " ", 
       RowBox[{"maximize", ".", 
        RowBox[{"-", 
         RowBox[{"var", ":", 
          RowBox[{
          "The", " ", "variable", " ", "with", " ", "respect", " ", "to", " ",
            "which", " ", "the", " ", "maximization", " ", "is", " ", 
           RowBox[{"performed", ".", "Returns"}]}], ":", 
          RowBox[{
          "A", " ", "logical", " ", "expression", " ", "from", " ", "Reduce", 
           " ", "describing", " ", "the", " ", "set", " ", "of", " ", "all", 
           " ", "points", " ", "that", " ", "correspond", " ", "to", " ", 
           "local", " ", 
           RowBox[{"maxima", ".", "Returns"}], " ", "a", " ", "message", " ", 
           "if", " ", "no", " ", "maxima", " ", "are", " ", 
           RowBox[{"found", "."}]}]}]}]}]}]}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"MyMax", "[", 
      RowBox[{"expr_", ",", "var_"}], "]"}], ":=", 
     RowBox[{"Module", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
        "firstDerivative", ",", "secondDerivative", ",", "maximaCondition"}], 
        "}"}], ",", 
       RowBox[{"(*", 
        RowBox[{
        "1.", " ", "Calculate", " ", "the", " ", "first", " ", "and", " ", 
         "second", " ", 
         RowBox[{"derivatives", "."}]}], "*)"}], 
       RowBox[{
        RowBox[{"firstDerivative", "=", 
         RowBox[{"D", "[", 
          RowBox[{"expr", ",", "var"}], "]"}]}], ";", "\[IndentingNewLine]", 
        RowBox[{"secondDerivative", "=", 
         RowBox[{"D", "[", 
          RowBox[{"expr", ",", 
           RowBox[{"{", 
            RowBox[{"var", ",", "2"}], "}"}]}], "]"}]}], ";", 

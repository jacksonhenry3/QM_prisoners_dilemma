Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
    RowBox[{
    "Function", " ", "to", " ", "find", " ", "critical", " ", "points", " ", 
     "where", " ", "the", " ", "first"}], "-", 
    RowBox[{"order", " ", "conditions", " ", "are", " ", 
     RowBox[{"met", "."}]}]}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"FindCriticalPoints", "[", 
     RowBox[{
     "ascore_", ",", "bscore_", ",", "avars_List", ",", "bvars_List"}], "]"}],
     ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"gradA", ",", "gradB", ",", "equations", ",", "allvars"}], 
       "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{
       "Calculate", " ", "the", " ", "gradient", " ", "of", " ", "each", " ", 
        RowBox[{"player", "'"}], "s", " ", "score", " ", 
        RowBox[{"w", ".", "r", ".", "t", ".", "their"}], " ", "own", " ", 
        "variables"}], "*)"}], "\[IndentingNewLine]", 
      RowBox[{
       RowBox[{
       "Print", "[", "\"\<Calculating and simplifying Grad A\>\"", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"gradA", "=", 
        RowBox[{
         RowBox[{"Grad", "[", 
          RowBox[{"ascore", ",", "avars"}], "]"}], "//", "FullSimplify"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{
       "Print", "[", "\"\<Calculating and simplifying Grad B\>\"", "]"}], ";",
        "\[IndentingNewLine]", 
       RowBox[{"gradB", "=", 
        RowBox[{
         RowBox[{"Grad", "[", 
          RowBox[{"bscore", ",", "bvars"}], "]"}], "//", "FullSimplify"}]}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Create", " ", "a", " ", "system", " ", "of", " ", "equations", " ", 
         "by", " ", "setting", " ", "the", " ", "gradients", " ", "to", " ", 
         "zero"}], "*)"}], 
       RowBox[{"equations", "=", 
        RowBox[{"Join", "[", 
         RowBox[{
          RowBox[{"Thread", "[", 
           RowBox[{"gradA", "==", "0"}], "]"}], ",", 
          RowBox[{"Thread", "[", 
           RowBox[{"gradB", "==", "0"}], "]"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Combine", " ", "all", " ", "strategy", " ", "variables", " ", "into",
          " ", "a", " ", "single", " ", "list"}], "*)"}], 
       RowBox[{"allvars", "=", 
        RowBox[{"Join", "[", 
         RowBox[{"avars", ",", "bvars"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "\"\<Solving\>\"", "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", "equations", "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Solve", " ", "the", " ", "system", " ", "for", " ", "the", " ", 
         "strategy", " ", "variables"}], "*)"}], " ", 
       RowBox[{"Solve", "[", 
        RowBox[{"equations", ",", "allvars"}], "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Function", " ", "to", " ", "verify", " ", "which", " ", "critical", " ",
       "points", " ", "are", " ", "Nash", " ", "Equilibria", " ", "by", " ", 
      "checking", " ", "second"}], "-", 
     RowBox[{"order", " ", 
      RowBox[{"conditions", "."}]}]}], "*)"}], 
   RowBox[{
    RowBox[{"VerifyNashEquilibria", "[", 
     RowBox[{
     "ascore_", ",", "bscore_", ",", "avars_List", ",", "bvars_List", ",", 
      "candidates_List"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"hessianA", ",", "hessianB", ",", "verifiedSolutions"}], "}"}],
       ",", 
      RowBox[{"(*", 
       RowBox[{
       "Calculate", " ", "the", " ", "Hessian", " ", "matrix", " ", "for", 
        " ", "each", " ", "player", " ", 
        RowBox[{"w", ".", "r", ".", "t", ".", "their"}], " ", "own", " ", 
        "variables"}], "*)"}], 
      RowBox[{
       RowBox[{"hessianA", "=", 
        RowBox[{"D", "[", 
         RowBox[{"ascore", ",", 
          RowBox[{"{", 
           RowBox[{"avars", ",", "2"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"hessianB", "=", 
        RowBox[{"D", "[", 
         RowBox[{"bscore", ",", 
          RowBox[{"{", 
           RowBox[{"bvars", ",", "2"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
         RowBox[{
         "Filter", " ", "candidates", " ", "by", " ", "checking", " ", "if", 
          " ", "both", " ", "Hessians", " ", "are", " ", "negative"}], "-", 
         "semidefinite"}], "*)"}], 
       RowBox[{"verifiedSolutions", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"candidates", ",", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{"(*", 
             RowBox[{
             "Substitute", " ", "solution", " ", "into", " ", "the", " ", 
              "Hessians"}], "*)"}], 
            RowBox[{
             RowBox[{"hA", "=", 
              RowBox[{"hessianA", "/.", " ", "#"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"hB", "=", 
              RowBox[{"hessianB", "/.", " ", "#"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", "\"\<===================\>\"", "]"}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{"hB", ",", "hA"}], "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"Print", "[", 
              RowBox[{
               RowBox[{"NegativeSemidefiniteMatrixQ", "[", "hA", "]"}], "&&", 
               RowBox[{"NegativeSemidefiniteMatrixQ", "[", "hB", "]"}]}], 
              "]"}], ";", "\[IndentingNewLine]", 
             RowBox[{"(*", 
              RowBox[{
               RowBox[{
               "Check", " ", "if", " ", "both", " ", "matrices", " ", "are", 
                " ", "negative"}], "-", "semidefinite"}], "*)"}], 
             RowBox[{"(*", 
              RowBox[{
              "This", " ", "confirms", " ", "a", " ", "local", " ", "maximum",
                " ", "for", " ", "each", " ", 
               RowBox[{"player", "'"}], "s", " ", "payoff", " ", 
               RowBox[{"function", "."}]}], "*)"}], 
             RowBox[{
              RowBox[{"NegativeSemidefiniteMatrixQ", "[", "hA", "]"}], "&&", 
              RowBox[{"NegativeSemidefiniteMatrixQ", "[", "hB", "]"}]}]}], 
            RowBox[{"(*", 
             RowBox[{"&&", 
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"Flatten", "[", "hA", "]"}], "]"}], "<", "0"}], "&&", 
              RowBox[{
               RowBox[{"Total", "[", 
                RowBox[{"Flatten", "[", "hB", "]"}], "]"}], "<", "0"}]}], 
             "*)"}], ")"}], "&"}]}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "verifiedSolutions", "]"}]}]}], "]"}]}], 
   "\[IndentingNewLine]", "\[IndentingNewLine]", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Function", " ", "to", " ", "find", " ", "and", " ", "filter", " ", 
      "for", " ", "possible", " ", "Nash", " ", 
      RowBox[{"Equilibria", ".", "It"}], " ", "returns", " ", "a", " ", 
      "list", " ", "of", " ", 
      RowBox[{"{", 
       RowBox[{"solution", ",", "conditions"}], "}"}], " ", "pairs"}], ",", 
     RowBox[{
     "excluding", " ", "those", " ", "whose", " ", "conditions", " ", "are", 
      " ", "impossible", " ", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"i", ".", "e", "."}], ",", "False"}], ")"}], "."}]}]}], 
    "*)"}], 
   RowBox[{
    RowBox[{"VerifyNashEquilibria", "[", 
     RowBox[{
     "ascore_", ",", "bscore_", ",", "avars_List", ",", "bvars_List", ",", 
      "candidates_List"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"hessianA", ",", "hessianB", ",", 
        RowBox[{"annotatedSolutions", "=", 
         RowBox[{"{", "}"}]}]}], "}"}], ",", 
      RowBox[{
       RowBox[{"hessianA", "=", 
        RowBox[{"D", "[", 
         RowBox[{"ascore", ",", 
          RowBox[{"{", 
           RowBox[{"avars", ",", "2"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"hessianB", "=", 
        RowBox[{"D", "[", 
         RowBox[{"bscore", ",", 
          RowBox[{"{", 
           RowBox[{"bvars", ",", "2"}], "}"}]}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Do", "[", 
        RowBox[{
         RowBox[{"Module", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
            "hA", ",", "hB", ",", "eigsA", ",", "eigsB", ",", "condsA", ",", 
             "condsB", ",", "strictConds", ",", "allConditions"}], "}"}], ",", 
           RowBox[{
            RowBox[{"hA", "=", 
             RowBox[{"hessianA", "/.", " ", "candidate"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"hB", "=", 
             RowBox[{"hessianB", "/.", " ", "candidate"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"eigsA", "=", 
             RowBox[{"Eigenvalues", "[", "hA", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"eigsB", "=", 
             RowBox[{"Eigenvalues", "[", "hB", "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"condsA", "=", 
             RowBox[{"Reduce", "[", 
              RowBox[{"And", "@@", 
               RowBox[{"Thread", "[", 
                RowBox[{"eigsA", "<=", "0"}], "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"condsB", "=", 
             RowBox[{"Reduce", "[", 
              RowBox[{"And", "@@", 
               RowBox[{"Thread", "[", 
                RowBox[{"eigsB", "<=", "0"}], "]"}]}], "]"}]}], ";", 
            "\[IndentingNewLine]", 
            RowBox[{"strictConds", "=", 
             RowBox[{"Reduce", "[", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Tr", "[", "hA", "]"}], "<", "0"}], ")"}], "&&", 
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"Tr", "[", "hB", "]"}], "<", "0"}], ")"}]}], "]"}]}],
             ";", "\[IndentingNewLine]", 
            RowBox[{"allConditions", "=", 
             RowBox[{"FullSimplify", "[", 
              RowBox[{"condsA", "&&", "condsB", "&&", "strictConds"}], 
              "]"}]}], ";", "\[IndentingNewLine]", 
            RowBox[{"(*", 
             RowBox[{
              RowBox[{
               RowBox[{"--", 
                RowBox[{"-", "THIS"}]}], " ", "IS", " ", "THE", " ", "NEW", 
               " ", 
               RowBox[{"PART", "--"}]}], "-"}], "*)"}], 
            RowBox[{"(*", 
             RowBox[{
             "Only", " ", "append", " ", "the", " ", "solution", " ", "if", 
              " ", "the", " ", "conditions", " ", "are", " ", "not", " ", 
              "trivially", " ", 
              RowBox[{"False", "."}]}], "*)"}], 
            RowBox[{"If", "[", 
             RowBox[{
              RowBox[{"allConditions", "=!=", "False"}], ",", 
              RowBox[{
               RowBox[{"AppendTo", "[", 
                RowBox[{"annotatedSolutions", ",", 
                 RowBox[{"{", 
                  RowBox[{"candidate", ",", "allConditions"}], "}"}]}], "]"}],
                ";"}]}], "]"}]}]}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"candidate", ",", "candidates"}], "}"}]}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Return", "[", "annotatedSolutions", "]"}], ";"}]}], 
     "]"}]}]}]}]], "Input",
 CellChangeTimes->{{3.959700797619545*^9, 3.959700831894451*^9}, {

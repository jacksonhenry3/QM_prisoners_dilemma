        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", 
             RowBox[{"5", "/", "3"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"Pi", "/", "2"}], ",", 
             RowBox[{"5", "/", "3"}]}], "}"}]}], "}"}], "]"}]}], "}"}], ",", 
      RowBox[{"(*", "Labels", "*)"}], 
      RowBox[{"Text", "[", 
       RowBox[{"\"\<classical\>\"", ",", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"Pi", "/", "8"}], ",", "1"}], "}"}], ",", 
        RowBox[{"{", 

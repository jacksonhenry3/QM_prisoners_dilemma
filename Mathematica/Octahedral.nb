Cell[BoxData[{
 RowBox[{
  RowBox[{
   RowBox[{"val", "=", 
    RowBox[{"2", " ", 
     RowBox[{"ArcTan", "[", 
      RowBox[{"Sqrt", "[", 
       RowBox[{"5", "-", 
        RowBox[{"2", " ", 
         RowBox[{"Sqrt", "[", "6", "]"}]}]}], "]"}], "]"}]}]}], ";"}], 
  "\[IndentingNewLine]"}], "\n", 
 RowBox[{"Plot", "[", 
  RowBox[{
   RowBox[{"Piecewise", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"2", "-", 
         RowBox[{"Cos", "[", 
          RowBox[{"2", " ", "\[Gamma]"}], "]"}]}], ",", 
        RowBox[{"\[Gamma]", "<=", "val"}]}], "}"}], "}"}], ",", 
     RowBox[{"-", "1"}]}], "]"}], ",", 
   RowBox[{"{", 
    RowBox[{"\[Gamma]", ",", "0", ",", 
     RowBox[{"Pi", "/", "2"}]}], "}"}], ",", 
   RowBox[{"PlotRange", "->", 
    RowBox[{"{", 
     RowBox[{"0", ",", "2"}], "}"}]}], ",", 
   RowBox[{"AxesLabel", "->", 
    RowBox[{"{", 
     RowBox[{"\"\<\[Gamma]\>\"", ",", "\"\<equilibrium payout\>\""}], "}"}]}],
    ",", 
   RowBox[{"Ticks", "->", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"Range", "[", 
       RowBox[{"0", ",", 
        RowBox[{"Pi", "/", "2"}], ",", 
        RowBox[{"Pi", "/", "8"}]}], "]"}], ",", "Automatic"}], "}"}]}], ",", 
   RowBox[{"Prolog", "->", 
    RowBox[{"{", 
     RowBox[{"{", 
      RowBox[{"Red", ",", 
       RowBox[{"Opacity", "[", "0.1", "]"}], ",", 
       RowBox[{"Rectangle", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"val", ",", "0"}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"Pi", "/", "2"}], ",", "2"}], "}"}]}], "]"}]}], "}"}], 
     "}"}]}], ",", 
   RowBox[{"Epilog", "->", 
    RowBox[{"{", 
     RowBox[{"(*", 
      RowBox[{"Horizontal", " ", "Lines"}], "*)"}], 
     RowBox[{
      RowBox[{"{", 
       RowBox[{"Dashed", ",", "Thin", ",", 
        RowBox[{"Line", "[", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"0", ",", "1"}], "}"}], ",", 

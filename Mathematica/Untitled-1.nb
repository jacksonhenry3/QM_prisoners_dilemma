   RowBox[{
    RowBox[{"gradA", "=", 
     RowBox[{"D", "[", 
      RowBox[{"scoreA", ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"\[Theta]a", ",", "\[Phi]a", ",", "sa"}], "}"}], "}"}]}], 
      "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"gradB", "=", 
     RowBox[{"D", "[", 
      RowBox[{"scoreB", ",", 
       RowBox[{"{", 
        RowBox[{"{", 
         RowBox[{"\[Theta]b", ",", "\[Phi]b", ",", "sb"}], "}"}], "}"}]}], 
      "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{"Pre", "-", 
     RowBox[{"compute", " ", "the", " ", 
      RowBox[{"Pi", "/", "8"}], " ", "grid", " ", 
      RowBox[{"(", 
       RowBox[{
        RowBox[{"17", "*", "17", "*", "5"}], "=", 
        RowBox[{"1445", " ", "coordinate", " ", "sets"}]}], ")"}]}]}], "*)"}],
    "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"gridPts", "=", 
     RowBox[{"SetPrecision", "[", 
      RowBox[{
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{"t", ",", "p", ",", "s"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"t", ",", "0", ",", 
             RowBox[{"2", " ", "Pi"}], ",", 
             RowBox[{"Pi", "/", "8"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"p", ",", "0", ",", 
             RowBox[{"2", " ", "Pi"}], ",", 
             RowBox[{"Pi", "/", "8"}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"s", ",", "0", ",", 
             RowBox[{"Pi", "/", "2"}], ",", 
             RowBox[{"Pi", "/", "8"}]}], "}"}]}], "]"}], ",", "2"}], "]"}], 
       ",", "30"}], "]"}]}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{"Send", " ", "all", " ", "definitions"}], ",", 
     RowBox[{"including", " ", "the", " ", "grid"}], ",", 
     RowBox[{"to", " ", "the", " ", "worker", " ", "kernels"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"DistributeDefinitions", "[", 
     RowBox[{
     "gammaVal", ",", "scoreA", ",", "scoreB", ",", "gradA", ",", "gradB", 
      ",", "gridPts"}], "]"}], ";"}], "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
    "2.", " ", "Encapsulate", " ", "the", " ", "Hybrid", " ", "IBR", " ", 
     "Loop", " ", "for", " ", "Worker", " ", "Nodes"}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"runIBRWorker", "[", "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "prec", ",", "tolerance", ",", "maxOuterTurns", ",", "maxInnerSteps", 
        ",", "posA", ",", "posB", ",", "subRules", ",", "stepSize", ",", 
        "innerIter", ",", "gradNorm", ",", "currentScore", ",", "currentGrad",
         ",", "proposedPosA", ",", "proposedScore", ",", "proposedPosB", ",", 
        "finalA", ",", "finalB"}], "}"}], ",", 
      RowBox[{
       RowBox[{"prec", "=", "30"}], ";", "\[IndentingNewLine]", 
       RowBox[{"tolerance", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"10", "^", 
           RowBox[{"-", "4"}]}], ",", "prec"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxOuterTurns", "=", "100"}], ";", "\[IndentingNewLine]", 
       RowBox[{"maxInnerSteps", "=", "50"}], ";", "\[IndentingNewLine]", 
       RowBox[{"posA", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}], ",", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}], ",", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"Pi", "/", "2"}]}], "}"}], "]"}]}], "}"}], ",", 
          "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"posB", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}], ",", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}], ",", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"Pi", "/", "2"}]}], "}"}], "]"}]}], "}"}], ",", 
          "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"subRules", "[", 
         RowBox[{"pa_", ",", "pb_"}], "]"}], ":=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Theta]a", "->", 
           RowBox[{"pa", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"\[Phi]a", "->", 
           RowBox[{"pa", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{"sa", "->", 
           RowBox[{"pa", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}], ",", 
          RowBox[{"\[Theta]b", "->", 
           RowBox[{"pb", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"\[Phi]b", "->", 
           RowBox[{"pb", "[", 
            RowBox[{"[", "2", "]"}], "]"}]}], ",", 
          RowBox[{"sb", "->", 
           RowBox[{"pb", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"turn", "=", "1"}], ",", 
         RowBox[{"turn", "<=", "maxOuterTurns"}], ",", 
         RowBox[{"turn", "++"}], ",", 
         RowBox[{"(*", " ", 
          RowBox[{
          "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
            "===", "===", "===", "==="}], "*)"}], 
         RowBox[{"(*", 
          RowBox[{
           RowBox[{"ALICE", "'"}], "S", " ", "TURN"}], "*)"}], 
         RowBox[{"(*", 
          RowBox[{"1.", " ", "Global", " ", "Jump", " ", 
           RowBox[{"(", 
            RowBox[{"Evaluate", " ", "opponent", " ", "against", " ", 
             RowBox[{"Pi", "/", "8"}], " ", "Grid"}], ")"}]}], "*)"}], 
         RowBox[{
          RowBox[{"posA", "=", 
           RowBox[{
            RowBox[{"MaximalBy", "[", 
             RowBox[{"gridPts", ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"scoreA", "/.", " ", 
                 RowBox[{"subRules", "[", 
                  RowBox[{"#", ",", "posB"}], "]"}]}], ")"}], "&"}]}], "]"}], 
            "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"2.", " ", "Local", " ", "Polish", " ", 
            RowBox[{"(", 
             RowBox[{"Gradient", " ", "Ascent"}], ")"}]}], "*)"}], 
          RowBox[{"stepSize", "=", 
           RowBox[{"SetPrecision", "[", 
            RowBox[{"0.1", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"innerIter", "=", "0"}], ";", 
          RowBox[{"gradNorm", "=", 
           RowBox[{"SetPrecision", "[", 
            RowBox[{"1.0", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"currentScore", "=", 
           RowBox[{"scoreA", "/.", " ", 
            RowBox[{"subRules", "[", 
             RowBox[{"posA", ",", "posB"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"innerIter", "<", "maxInnerSteps"}], "&&", 
             RowBox[{"gradNorm", ">", "tolerance"}]}], ",", 
            RowBox[{
             RowBox[{"currentGrad", "=", 
              RowBox[{"gradA", "/.", " ", 
               RowBox[{"subRules", "[", 
                RowBox[{"posA", ",", "posB"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"proposedPosA", "=", 
              RowBox[{"posA", "+", 
               RowBox[{"stepSize", "*", "currentGrad"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"proposedPosA", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "=", 
              RowBox[{"Clip", "[", 
               RowBox[{
                RowBox[{"proposedPosA", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", 
                  RowBox[{"Pi", "/", "2"}]}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"proposedScore", "=", 
              RowBox[{"scoreA", "/.", " ", 
               RowBox[{"subRules", "[", 
                RowBox[{"proposedPosA", ",", "posB"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"proposedScore", ">=", "currentScore"}], ",", 
               RowBox[{
                RowBox[{"innerIter", "++"}], ";", 
                RowBox[{"posA", "=", "proposedPosA"}], ";", 
                RowBox[{"currentScore", "=", "proposedScore"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"gradNorm", "=", 
                 RowBox[{"Norm", "[", "currentGrad", "]"}]}], ";", 
                RowBox[{"stepSize", "*=", "1.1"}], ";"}], ",", 
               RowBox[{
                RowBox[{"stepSize", "*=", "0.5"}], ";"}]}], "]"}], ";"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "==="}], "*)"}], 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"BOB", "'"}], "S", " ", "TURN"}], "*)"}], 
          RowBox[{"(*", 
           RowBox[{"1.", " ", "Global", " ", "Jump", " ", 
            RowBox[{"(", 
             RowBox[{"Evaluate", " ", "opponent", " ", "against", " ", 
              RowBox[{"Pi", "/", "8"}], " ", "Grid"}], ")"}]}], "*)"}], 
          RowBox[{"posB", "=", 
           RowBox[{
            RowBox[{"MaximalBy", "[", 
             RowBox[{"gridPts", ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"scoreB", "/.", " ", 
                 RowBox[{"subRules", "[", 
                  RowBox[{"posA", ",", "#"}], "]"}]}], ")"}], "&"}]}], "]"}], 
            "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"2.", " ", "Local", " ", "Polish", " ", 
            RowBox[{"(", 
             RowBox[{"Gradient", " ", "Ascent"}], ")"}]}], "*)"}], 
          RowBox[{"stepSize", "=", 
           RowBox[{"SetPrecision", "[", 
            RowBox[{"0.1", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"innerIter", "=", "0"}], ";", 
          RowBox[{"gradNorm", "=", 
           RowBox[{"SetPrecision", "[", 
            RowBox[{"1.0", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"currentScore", "=", 
           RowBox[{"scoreB", "/.", " ", 
            RowBox[{"subRules", "[", 
             RowBox[{"posA", ",", "posB"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"innerIter", "<", "maxInnerSteps"}], "&&", 
             RowBox[{"gradNorm", ">", "tolerance"}]}], ",", 
            RowBox[{
             RowBox[{"currentGrad", "=", 
              RowBox[{"gradB", "/.", " ", 
               RowBox[{"subRules", "[", 
                RowBox[{"posA", ",", "posB"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"proposedPosB", "=", 
              RowBox[{"posB", "+", 
               RowBox[{"stepSize", "*", "currentGrad"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"proposedPosB", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "=", 
              RowBox[{"Clip", "[", 
               RowBox[{
                RowBox[{"proposedPosB", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", 
                  RowBox[{"Pi", "/", "2"}]}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"proposedScore", "=", 
              RowBox[{"scoreB", "/.", " ", 
               RowBox[{"subRules", "[", 
                RowBox[{"posA", ",", "proposedPosB"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"proposedScore", ">=", "currentScore"}], ",", 
               RowBox[{
                RowBox[{"innerIter", "++"}], ";", 
                RowBox[{"posB", "=", "proposedPosB"}], ";", 
                RowBox[{"currentScore", "=", "proposedScore"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"gradNorm", "=", 
                 RowBox[{"Norm", "[", "currentGrad", "]"}]}], ";", 
                RowBox[{"stepSize", "*=", "1.1"}], ";"}], ",", 
               RowBox[{
                RowBox[{"stepSize", "*=", "0.5"}], ";"}]}], "]"}], ";"}]}], 
           "]"}], ";"}]}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"finalA", "=", 
        RowBox[{"scoreA", "/.", " ", 
         RowBox[{"subRules", "[", 
          RowBox[{"posA", ",", "posB"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"finalB", "=", 
        RowBox[{"scoreB", "/.", " ", 
         RowBox[{"subRules", "[", 
          RowBox[{"posA", ",", "posB"}], "]"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"<|", 
        RowBox[{
         RowBox[{"\"\<AliceFinalScore\>\"", "->", "finalA"}], ",", 

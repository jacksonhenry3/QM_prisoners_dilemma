            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}], ",", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}], ",", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"Pi", "/", "2"}]}], "}"}], "]"}]}], "}"}], ",", 
          "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"posB", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}], ",", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"2", " ", "Pi"}]}], "}"}], "]"}], ",", 
            RowBox[{"RandomReal", "[", 
             RowBox[{"{", 
              RowBox[{"0", ",", 
               RowBox[{"Pi", "/", "2"}]}], "}"}], "]"}]}], "}"}], ",", 
          "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{
        RowBox[{"subRules", "[", 
         RowBox[{"pa_", ",", "pb_"}], "]"}], ":=", 
        RowBox[{"{", 
         RowBox[{
          RowBox[{"\[Theta]a", "->", 
           RowBox[{"pa", "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ",", 
          RowBox[{"\[Phi]a", "->", 

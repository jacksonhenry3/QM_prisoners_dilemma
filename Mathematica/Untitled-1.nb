        "finalA", ",", "finalB", ",", "bestGridStart"}], "}"}], ",", 
      RowBox[{
       RowBox[{"prec", "=", "30"}], ";", "\[IndentingNewLine]", 
       RowBox[{"tolerance", "=", 
        RowBox[{"SetPrecision", "[", 
         RowBox[{
          RowBox[{"10", "^", 
           RowBox[{"-", "4"}]}], ",", "prec"}], "]"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"maxOuterTurns", "=", "10"}], ";", "\[IndentingNewLine]", 
       RowBox[{"maxInnerSteps", "=", "50"}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "Start", " ", "with", " ", "random", " ", "initial", " ", 

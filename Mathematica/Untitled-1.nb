          RowBox[{"sb", "->", 
           RowBox[{"pb", "[", 
            RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"For", "[", 
        RowBox[{
         RowBox[{"turn", "=", "1"}], ",", 

          RowBox[{"stepSize", "=", 
           RowBox[{"SetPrecision", "[", 
            RowBox[{"0.1", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"innerIter", "=", "0"}], ";", 
          RowBox[{"gradNorm", "=", 
           RowBox[{"SetPrecision", "[", 
            RowBox[{"1.0", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"currentScore", "=", 
           RowBox[{"scoreA", "/.", " ", 
            RowBox[{"subRules", "[", 
             RowBox[{"posA", ",", "posB"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"innerIter", "<", "maxInnerSteps"}], "&&", 
             RowBox[{"gradNorm", ">", "tolerance"}]}], ",", 
            RowBox[{
             RowBox[{"currentGrad", "=", 
              RowBox[{"gradA", "/.", " ", 
               RowBox[{"subRules", "[", 
                RowBox[{"posA", ",", "posB"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"proposedPosA", "=", 
              RowBox[{"posA", "+", 
               RowBox[{"stepSize", "*", "currentGrad"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{
              RowBox[{"proposedPosA", "[", 
               RowBox[{"[", "3", "]"}], "]"}], "=", 
              RowBox[{"Clip", "[", 
               RowBox[{
                RowBox[{"proposedPosA", "[", 
                 RowBox[{"[", "3", "]"}], "]"}], ",", 
                RowBox[{"{", 
                 RowBox[{"0", ",", 
                  RowBox[{"Pi", "/", "2"}]}], "}"}]}], "]"}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"proposedScore", "=", 
              RowBox[{"scoreA", "/.", " ", 
               RowBox[{"subRules", "[", 
                RowBox[{"proposedPosA", ",", "posB"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"proposedScore", ">=", "currentScore"}], ",", 
               RowBox[{
                RowBox[{"innerIter", "++"}], ";", 
                RowBox[{"posA", "=", "proposedPosA"}], ";", 
                RowBox[{"currentScore", "=", "proposedScore"}], ";", 
                "\[IndentingNewLine]", 
                RowBox[{"gradNorm", "=", 
                 RowBox[{"Norm", "[", "currentGrad", "]"}]}], ";", 
                RowBox[{"stepSize", "*=", "1.1"}], ";"}], ",", 
               RowBox[{
                RowBox[{"stepSize", "*=", "0.5"}], ";"}]}], "]"}], ";"}]}], 
           "]"}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", " ", 
           RowBox[{
           "===", "===", "===", "===", "===", "===", "===", "===", "===", "===",
             "===", "===", "===", "==="}], "*)"}], 
          RowBox[{"(*", 
           RowBox[{
            RowBox[{"BOB", "'"}], "S", " ", "TURN"}], "*)"}], 
          RowBox[{"(*", 
           RowBox[{"1.", " ", "Global", " ", "Jump", " ", 
            RowBox[{"(", 
             RowBox[{
              RowBox[{"Pi", "/", "8"}], " ", "Grid"}], ")"}]}], "*)"}], 
          RowBox[{"posB", "=", 
           RowBox[{
            RowBox[{"MaximalBy", "[", 
             RowBox[{"gridPts", ",", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{"scoreB", "/.", " ", 
                 RowBox[{"subRules", "[", 
                  RowBox[{"posA", ",", "#"}], "]"}]}], ")"}], "&"}]}], "]"}], 
            "[", 
            RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"(*", 
           RowBox[{"2.", " ", "Local", " ", "Polish", " ", 
            RowBox[{"(", 
             RowBox[{"Gradient", " ", "Ascent"}], ")"}]}], "*)"}], 
          RowBox[{"stepSize", "=", 
           RowBox[{"SetPrecision", "[", 
            RowBox[{"0.1", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"innerIter", "=", "0"}], ";", 
          RowBox[{"gradNorm", "=", 
           RowBox[{"SetPrecision", "[", 
            RowBox[{"1.0", ",", "prec"}], "]"}]}], ";", "\[IndentingNewLine]", 
          RowBox[{"currentScore", "=", 
           RowBox[{"scoreB", "/.", " ", 
            RowBox[{"subRules", "[", 
             RowBox[{"posA", ",", "posB"}], "]"}]}]}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"While", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"innerIter", "<", "maxInnerSteps"}], "&&", 
             RowBox[{"gradNorm", ">", "tolerance"}]}], ",", 
            RowBox[{
             RowBox[{"currentGrad", "=", 

         RowBox[{"\"\<TotalScore\>\"", "->", 
          RowBox[{"(", 
           RowBox[{"finalA", "+", "finalB"}], ")"}]}], ",", 
         RowBox[{"\"\<AliceFinalParams\>\"", "->", "posA"}], ",", 
         RowBox[{"\"\<BobFinalParams\>\"", "->", "posB"}]}], "|>"}]}]}], 
     "]"}]}], "\n", "\[IndentingNewLine]", 

Cell[CellGroupData[{

Cell[BoxData[
 RowBox[{
  RowBox[{"(*", 
   RowBox[{
   "Function", " ", "to", " ", "rigorously", " ", "verify", " ", "if", " ", 
    "a", " ", "strategy", " ", "pair", " ", "is", " ", "a", " ", "Nash", " ", 
    "Equilibrium"}], "*)"}], 
  RowBox[{
   RowBox[{
    RowBox[{"verifyNash", "[", 
     RowBox[{"stratA_", ",", "stratB_", ",", "gammaVal_"}], "]"}], ":=", 
    RowBox[{"Module", "[", 
     RowBox[{
      RowBox[{"{", 
       RowBox[{
       "scoreA", ",", "scoreB", ",", "maxA", ",", "maxB", ",", "isNashA", ",",
         "isNashB", ",", 
        RowBox[{"tol", "=", 
         RowBox[{"10", "^", 
          RowBox[{"-", "5"}]}]}]}], "}"}], ",", 
      RowBox[{"(*", 
       RowBox[{"1.", " ", "Calculate", " ", "current", " ", "payoffs"}], 
       "*)"}], 
      RowBox[{
       RowBox[{"scoreA", "=", 
        RowBox[{"ascorSimp", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]", "->", "gammaVal"}], ",", 
           RowBox[{"\[Theta]a", "->", 
            RowBox[{"stratA", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"\[Phi]a", "->", 
            RowBox[{"stratA", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", 
           RowBox[{"sa", "->", 
            RowBox[{"stratA", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ",", 
           RowBox[{"\[Theta]b", "->", 
            RowBox[{"stratB", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"\[Phi]b", "->", 
            RowBox[{"stratB", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", 
           RowBox[{"sb", "->", 
            RowBox[{"stratB", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"scoreB", "=", 
        RowBox[{"bscorSimp", "/.", " ", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{"\[Gamma]", "->", "gammaVal"}], ",", 
           RowBox[{"\[Theta]a", "->", 
            RowBox[{"stratA", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"\[Phi]a", "->", 
            RowBox[{"stratA", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", 
           RowBox[{"sa", "->", 
            RowBox[{"stratA", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}], ",", 
           RowBox[{"\[Theta]b", "->", 
            RowBox[{"stratB", "[", 
             RowBox[{"[", "1", "]"}], "]"}]}], ",", 
           RowBox[{"\[Phi]b", "->", 
            RowBox[{"stratB", "[", 
             RowBox[{"[", "2", "]"}], "]"}]}], ",", 
           RowBox[{"sb", "->", 
            RowBox[{"stratB", "[", 
             RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "2.", " ", "Find", " ", "maximum", " ", "possible", " ", "score", " ",
          "by", " ", "unilateral", " ", "deviation"}], "*)"}], 
       RowBox[{"maxA", "=", 
        RowBox[{
         RowBox[{"NMaximize", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"ascorSimp", "/.", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\[Gamma]", "->", "gammaVal"}], ",", 
                RowBox[{"\[Theta]b", "->", 
                 RowBox[{"stratB", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                RowBox[{"\[Phi]b", "->", 
                 RowBox[{"stratB", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                RowBox[{"sb", "->", 
                 RowBox[{"stratB", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ",", 
             RowBox[{"0", "<=", "\[Theta]a", "<=", 
              RowBox[{"2", " ", "Pi"}]}], ",", 
             RowBox[{"0", "<=", "\[Phi]a", "<=", 
              RowBox[{"2", " ", "Pi"}]}], ",", 
             RowBox[{"0", "<=", "sa", "<=", 
              RowBox[{"Pi", "/", "2"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Theta]a", ",", "\[Phi]a", ",", "sa"}], "}"}]}], "]"}], 
         "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"maxB", "=", 
        RowBox[{
         RowBox[{"NMaximize", "[", 
          RowBox[{
           RowBox[{"{", 
            RowBox[{
             RowBox[{"bscorSimp", "/.", " ", 
              RowBox[{"{", 
               RowBox[{
                RowBox[{"\[Gamma]", "->", "gammaVal"}], ",", 
                RowBox[{"\[Theta]a", "->", 
                 RowBox[{"stratA", "[", 
                  RowBox[{"[", "1", "]"}], "]"}]}], ",", 
                RowBox[{"\[Phi]a", "->", 
                 RowBox[{"stratA", "[", 
                  RowBox[{"[", "2", "]"}], "]"}]}], ",", 
                RowBox[{"sa", "->", 
                 RowBox[{"stratA", "[", 
                  RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}]}], ",", 
             RowBox[{"0", "<=", "\[Theta]b", "<=", 
              RowBox[{"2", " ", "Pi"}]}], ",", 
             RowBox[{"0", "<=", "\[Phi]b", "<=", 
              RowBox[{"2", " ", "Pi"}]}], ",", 
             RowBox[{"0", "<=", "sb", "<=", 
              RowBox[{"Pi", "/", "2"}]}]}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"\[Theta]b", ",", "\[Phi]b", ",", "sb"}], "}"}]}], "]"}], 
         "[", 
         RowBox[{"[", "1", "]"}], "]"}]}], ";", "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{
        "3.", " ", "Check", " ", "if", " ", "deviation", " ", "yields", " ", 
         "improvement", " ", 
         RowBox[{"(", 
          RowBox[{
          "accounting", " ", "for", " ", "floating", " ", "point", " ", 
           "noise"}], ")"}]}], "*)"}], 
       RowBox[{"isNashA", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"maxA", "-", "scoreA"}], ")"}], "<", "tol"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"isNashB", "=", 
        RowBox[{
         RowBox[{"(", 
          RowBox[{"maxB", "-", "scoreB"}], ")"}], "<", "tol"}]}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"(*", 
        RowBox[{"4.", " ", "Output", " ", "validation"}], "*)"}], 
       RowBox[{
       "Print", "[", "\"\<--- NASH EQUILIBRIUM VERIFICATION ---\>\"", "]"}], 
       ";", "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Current Payoffs  -> Alice: \>\"", ",", "scoreA", ",", 
         "\"\< | Bob: \>\"", ",", "scoreB"}], "]"}], ";", 
       "\[IndentingNewLine]", 
       RowBox[{"Print", "[", 
        RowBox[{
        "\"\<Max Deviations   -> Alice: \>\"", ",", "maxA", ",", 
         "\"\< | Bob: \>\"", ",", "maxB"}], "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"If", "[", 
        RowBox[{
         RowBox[{"isNashA", "&&", "isNashB"}], ",", 
         RowBox[{
         "Print", "[", "\"\<\\nRESULT: TRUE. Stable Nash Equilibrium.\>\"", 
          "]"}], ",", 
         RowBox[{
          RowBox[{"Print", "[", "\"\<\\nRESULT: FALSE. Unstable.\>\"", "]"}], 
          ";", "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", "isNashA"}], ",", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Alice can unilaterally improve by: \>\"", ",", 
              RowBox[{"maxA", "-", "scoreA"}]}], "]"}]}], "]"}], ";", 
          "\[IndentingNewLine]", 
          RowBox[{"If", "[", 
           RowBox[{
            RowBox[{"!", "isNashB"}], ",", 
            RowBox[{"Print", "[", 
             RowBox[{"\"\<Bob can unilaterally improve by: \>\"", ",", 
              RowBox[{"maxB", "-", "scoreB"}]}], "]"}]}], "]"}], ";"}]}], 
        "]"}], ";", "\[IndentingNewLine]", 
       RowBox[{"Return", "[", 
        RowBox[{"isNashA", "&&", "isNashB"}], "]"}], ";"}]}], "]"}]}], 
   "\[IndentingNewLine]", "\n", 
   RowBox[{"(*", 
    RowBox[{
     RowBox[{
     "Example", " ", "Execution", " ", "using", " ", "your", " ", 
      "\[Gamma]"}], "=", 
     RowBox[{
      RowBox[{"\[Pi]", "/", "8"}], " ", "results"}]}], "*)"}], 
   "\[IndentingNewLine]", 
   RowBox[{
    RowBox[{"testAlice", "=", 
     RowBox[{"bestRun", "[", "\"\<AliceFinalParams\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"testBob", "=", 
     RowBox[{"bestRun", "[", "\"\<BobFinalParams\>\"", "]"}]}], ";"}], "\n", 
   RowBox[{
    RowBox[{"verifyNash", "[", 
     RowBox[{"testAlice", ",", "testBob", ",", 
      RowBox[{"Pi", "/", "8"}]}], "]"}], ";"}]}]}]], "Input",
 CellChangeTimes->{{3.991387939531847*^9, 3.9913879395328484`*^9}, 
   3.991389944537634*^9, {3.9913900003555355`*^9, 3.9913900131903915`*^9}},
 CellLabel->

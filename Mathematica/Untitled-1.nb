                RowBox[{"posA", ",", "posB"}], "]"}]}]}], ";", 
             "\[IndentingNewLine]", 
             RowBox[{"proposedPosB", "=", 
              RowBox[{"posB", "+", 
               RowBox[{"stepSize", "*", "currentGrad"}]}]}], ";", 
